@inherits LayoutComponentBase
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@using System.Reflection

<AuthenticationGuard>
    <PageTitle>Cassandra Migration Utility</PageTitle>

    <div class="page">
        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9.5 2L2 6v6l7.5 4L17 12V6L9.5 2z" fill="#50e6ff" opacity=".8"/>
                        <path d="M9.5 2L2 6l7.5 4L17 6 9.5 2z" fill="#fff" opacity=".3"/>
                        <path d="M2 6v6l7.5 4V10L2 6z" fill="#0078d4" opacity=".6"/>
                        <path d="M17 6v6l-7.5 4V10L17 6z" fill="#0078d4" opacity=".4"/>
                    </svg>
                    <h2>Cassandra Migration</h2>
                </div>
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small">@DisplayVersion</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/change-password"))">
                                <i class="bi bi-key"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <span class="small">@DisplayVersion</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</AuthenticationGuard>

@code {
    // Single source of truth: derived from the assembly's
    // <Version>/<AssemblyInformationalVersion> at build time, so future
    // releases update by bumping the csproj only.
    private static readonly string DisplayVersion = ResolveDisplayVersion();

    private static string ResolveDisplayVersion()
    {
        var assembly = typeof(MainLayout).Assembly;
        var info = assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion;
        if (!string.IsNullOrWhiteSpace(info))
        {
            // Strip any '+<git-sha>' build metadata SemVer suffix.
            int plus = info.IndexOf('+');
            if (plus > 0) info = info.Substring(0, plus);
            return "v" + info;
        }
        var v = assembly.GetName().Version;
        return v != null ? $"v{v.Major}.{v.Minor}.{v.Build}" : "v?";
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}
