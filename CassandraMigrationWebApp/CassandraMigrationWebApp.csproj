  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CassandraMigrationProcessor\CassandraMigrationProcessor.csproj" />
  </ItemGroup>

</Project>
