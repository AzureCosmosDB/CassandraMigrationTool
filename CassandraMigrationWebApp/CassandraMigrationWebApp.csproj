    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CassandraMigrationWebApp</RootNamespace>
    <UserSecretsId>cassandra-migration-tool</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
