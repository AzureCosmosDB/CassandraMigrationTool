@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Models
@using CassandraMigrationProcessor.Infrastructure

@if (Job != null)
{
    var sj = Job;
    var allUnits = sj.Tables;
    var realUnits = allUnits.Where(u => u.TableName != "*").ToList();
    int wildcardPending = allUnits.Count - realUnits.Count;
    int totalTables = realUnits.Count;
    int copyDone = realUnits.Count(u => u.CopyComplete);
    bool onlineReplayActive = sj.IsOnline
        && !sj.Status.IsTerminal()
        && copyDone > 0;
    int replayingTables = onlineReplayActive ? copyDone : 0;
    int inProgress = realUnits.Count(u => !u.CopyComplete
        && (u.CopyPercent > 0 || u.CopyRowsCopied > 0 || u.CopyRowsPerSecond > 0));
    int failedTables = realUnits.Count(u => u.SourceStatus == TableStatus.Failed);
    int onlineCounterTables = sj.IsOnline
        ? realUnits.Count(u => u.IsCounterTable)
        : 0;
    var countableUnits = sj.IsOnline
        ? realUnits.Where(u => !u.IsCounterTable).ToList()
        : realUnits;
    bool allRowCountsUnavailable = realUnits.Count > 0 && countableUnits.Count == 0;
    long bulkRows = countableUnits.Sum(u => (long)u.CopyRowsCopied);
    long replayWrites = realUnits.Sum(u => (long)u.ChangeFeedRowsInserted);
    long totalDocs = countableUnits.Sum(u => (long)u.TotalRowCount);
    double avgSpeed = countableUnits.Where(u => u.CopyRowsPerSecond > 0).Select(u => u.CopyRowsPerSecond).DefaultIfEmpty(0).Sum();
    bool showReplayWrites = sj.IsOnline && replayWrites > 0;
    string rowsTooltip = onlineCounterTables > 0
        ? "Online counter tables are excluded because Cosmos change feed items are not distinct logical rows."
        : "Rows written during the bulk-copy phase. CDC replay writes are counted separately.";
    bool denominatorStale = totalDocs > 0 && bulkRows > totalDocs;

    @if (sj.IsSimulatedRun)
    {
        <div class="alert alert-warning py-2 mb-2" role="alert">
            <i class="bi bi-eye" aria-hidden="true"></i>
            <strong>Simulation Mode</strong> — this job ran with target writes
            disabled. No data was written to the target cluster. Use this as
            an audit / dry-run only; promote to a real run by creating a new
            job with Simulated unchecked.
        </div>
    }

    <div class="card mb-3 mt-2">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <span class="badge @StatusBadge fs-6">@StatusLabel</span>
                    @if (sj.IsSimulatedRun)
                    {
                        <span class="badge bg-warning text-dark fs-6 ms-2" title="Simulation mode — no target writes happened.">
                            <i class="bi bi-eye" aria-hidden="true"></i> Simulated
                        </span>
                    }
                </div>
                <div class="col">
                    <small class="text-muted">
                        <strong>Type:</strong> CQL Copy
                        @if (sj.IsOnline) { <span> · <strong>Mode:</strong> Online (CDC)</span> }
                        else { <span> · <strong>Mode:</strong> Offline</span> }
                        @if (sj.StartedOn.HasValue) { <span> · <strong>Started:</strong> @sj.StartedOn.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }
                    </small>
                </div>
            </div>
            <hr class="my-1" />
            <div class="row">
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-table"></i>
                        @if (onlineReplayActive)
                        {
                            <strong>Tables:</strong> <span>@copyDone/@totalTables bulk done</span>
                            <span class="text-info ms-1"
                                  title="Bulk copy has finished for these tables but CDC replay is still draining live source mutations. Until you click Cut Over, the job is NOT complete.">
                                · @replayingTables in CDC replay (waiting for cut over)
                            </span>
                        }
                        else
                        {
                            <strong>Tables:</strong> <span>@copyDone/@totalTables done</span>
                        }
                        @if (inProgress > 0) { <span>, @inProgress active</span> }
                        @if (failedTables > 0) { <span class="text-danger">, @failedTables failed</span> }
                        @if (wildcardPending > 0)
                        {
                            <span class="text-info ms-1"
                                  title="One or more 'keyspace.*' wildcards are queued and will be expanded into individual tables during the schema phase. The count above does not include the wildcard itself.">
                                (+@wildcardPending wildcard pending expansion)
                            </span>
                        }
                        @if (sj.Status == JobStatus.Paused) { <span class="text-warning"> (paused)</span> }
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted" title="@rowsTooltip">
                        <i class="bi bi-files"></i>
                        <strong>Rows copied:</strong>
                        @if (allRowCountsUnavailable)
                        {
                            <span>Unavailable for online counter migration</span>
                        }
                        else
                        {
                            <span>@bulkRows.ToString("N0")@(!denominatorStale && totalDocs > 0 ? $" / {totalDocs:N0}" : "")</span>
                            @if (denominatorStale)
                            {
                                <span class="text-warning ms-1" style="font-size: 0.75rem;"
                                      title="@($"Source likely received writes during bulk copy: numerator ({bulkRows:N0}) exceeded the pre-job estimate ({totalDocs:N0}). The / denominator is hidden to avoid showing > 100% completion.")">
                                    (estimate stale)
                                </span>
                            }
                            @if (onlineCounterTables > 0)
                            {
                                <span class="text-muted ms-1" style="font-size: 0.75rem;">
                                    (excludes @onlineCounterTables counter @(onlineCounterTables == 1 ? "table" : "tables"))
                                </span>
                            }
                        }
                    </small>
                </div>
                @if (showReplayWrites)
                {
                    <div class="col-auto">
                        <small class="text-muted"
                               title="Successful CDC replay write operations. Repeated updates to the same logical row are counted separately.">
                            <i class="bi bi-arrow-repeat"></i>
                            <strong>CDC writes applied:</strong> @replayWrites.ToString("N0")
                        </small>
                    </div>
                }
                @if (totalDocs > 0)
                {
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-database"></i>
                        <strong>Total documents:</strong> @totalDocs.ToString("N0")
                    </small>
                </div>
                }
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-speedometer2"></i>
                        <strong>Speed:</strong>
                        @(avgSpeed >= 1000 ? $"{avgSpeed/1000:F1}k/s" : $"{avgSpeed:F0}/s")
                    </small>
                </div>
                @if (!allRowCountsUnavailable && avgSpeed > 0 && totalDocs > bulkRows)
                {
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i>
                        <strong>ETA:</strong>
                        @JobLifecycle.FormatEta(totalDocs - bulkRows, avgSpeed)
                    </small>
                </div>
                }
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-cpu"></i>
                        <strong>Shared workers:</strong> @(sj.WorkerCount > 0 ? sj.WorkerCount.ToString() : $"auto ({Math.Max(MigrationDefaults.MinWorkers, Environment.ProcessorCount * MigrationDefaults.WorkerMultiplier)})")
                        · <strong>Source conn/host:</strong> @FormatConnPerHost(sj.SourceMaxConnectionsPerHost, sj.MaxConnectionsPerHost)
                        · <strong>Target conn/host:</strong> @FormatConnPerHost(sj.TargetMaxConnectionsPerHost, sj.MaxConnectionsPerHost)
                        · <strong>Page size:</strong> @(sj.PageSize > 0 ? sj.PageSize.ToString() : "500")
                        · <strong>Target write CL:</strong> @FormatConsistencyLevel(sj.TargetWriteConsistencyLevel)
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-hdd-network"></i>
                        <strong>Namespaces:</strong> @(sj.Namespaces ?? "all")
                    </small>
                </div>
                @if (sj.DropTargetTableBeforeStart)
                {
                    <div class="col-auto">
                        <span class="badge bg-danger">Drop target tables</span>
                    </div>
                }
                @if (sj.SkipSchemaSync)
                {
                    <div class="col-auto">
                        <span class="badge bg-warning text-dark" title="Schema sync was skipped — target schema (keyspaces, tables, UDTs) was assumed to already exist.">Skip schema sync</span>
                    </div>
                }
                @if (sj.SkipSourceRowCount)
                {
                    <div class="col-auto">
                        <span class="badge bg-warning text-dark" title="SELECT COUNT(*) on the source was skipped — per-table progress shows the live copy rate (e.g. 'Copying (3k/s)') rather than a percentage until the migration completes.">Skip source COUNT(*)</span>
                    </div>
                }
                @if (sj.AppendMode)
                {
                    <div class="col-auto">
                        <span class="badge bg-info">Append mode</span>
                    </div>
                }
                @if (sj.PreserveCellTtlAndWritetime)
                {
                    <div class="col-auto">
                        <span class="badge bg-info" title="Per-cell TTL and writetime preservation was enabled — divergent rows used a row-level INSERT followed by cell-level UPDATE statements to preserve row liveness.">Per-cell TTL/writetime</span>
                    </div>
                }
                @if (!sj.UseJsonCopy)
                {
                    <div class="col-auto">
                        <span class="badge bg-warning text-dark" title="Fast binary copy mode (SELECT * / typed INSERT) — materially faster, but TTL and writetime are NOT preserved.">Fast copy (no TTL/writetime)</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Job? Job { get; set; }
    [Parameter] public string StatusLabel { get; set; } = string.Empty;
    [Parameter] public string StatusBadge { get; set; } = string.Empty;

    private static string FormatConnPerHost(int sideValue, int fallback)
    {
        int effective = sideValue > 0 ? sideValue : fallback;
        return effective > 0 ? effective.ToString() : "driver default";
    }

    private static string FormatConsistencyLevel(
        TargetWriteConsistencyLevel consistencyLevel)
        => consistencyLevel switch
        {
            TargetWriteConsistencyLevel.LocalOne => "LOCAL_ONE",
            TargetWriteConsistencyLevel.LocalQuorum => "LOCAL_QUORUM",
            TargetWriteConsistencyLevel.EachQuorum => "EACH_QUORUM",
            _ => consistencyLevel.ToString().ToUpperInvariant()
        };
}
