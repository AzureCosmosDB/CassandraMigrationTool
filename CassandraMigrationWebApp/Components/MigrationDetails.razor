@inject Service.JobManager JobManager
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

@using Microsoft.JSInterop
@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Context
@using CassandraMigrationProcessor.Infrastructure
@using CassandraMigrationProcessor.Models

<div class="modal fade show d-block bg-dark bg-opacity-75" id="myModal" aria-modal="true" role="dialog">
    <div class="modal-dialog bg-dark">
        <div class="modal-content">
            <div class="modal-header">
       <h4 class="modal-title">@(NewMode ? "New Job Details" : "Update Connection Strings")</h4>
           <button type="button" class="btn-close" aria-label="Close" @onclick="@Cancel"></button>
 </div>
       <div class="modal-body">
                <!-- Tab Navigation -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "Basic" ? "active" : "")" @onclick='() => activeTab = "Basic"'>Basic</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "Advanced" ? "active" : "")" @onclick='() => activeTab = "Advanced"'>Advanced</button>
                    </li>
                </ul>

                <!-- Basic Tab Content -->
                <div class="@(activeTab == "Basic" ? "" : "d-none")">
                    <!-- Basic Tab Fields -->
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" id="name" class="form-control" maxlength="128" disabled="@(!NewMode)" @bind="name" />
                    </div>
                    @if (NewMode)
                    {
                        <div class="mb-3">
                            <label for="migration-tool" class="form-label">Migration Tool</label>
                            <select id="migration-tool" class="form-select" disabled>
                                <option value="CqlCopy" selected>CQL Copy</option>
                            </select>
                        </div>
                    }
                    <!-- Source Connection -->
                    <h6 class="mt-3 mb-2 text-muted">Source (Cosmos DB Cassandra)</h6>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <label for="sourceConnectionString" class="form-label">Connection String</label>
                            <input type="text" id="sourceConnectionString" placeholder="@(NewMode ? "e.g. myaccount.cassandra.cosmos.azure.com" : "")" class="form-control" maxlength="1024" @bind="sourceConnectionString" />
                        </div>
                        <div class="col-md-4">
                            <label for="sourcePort" class="form-label">Port</label>
                            <input type="number" id="sourcePort" class="form-control" min="1" max="65535" @bind="sourcePort" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label for="sourceUsername" class="form-label">Username</label>
                            <input type="text" id="sourceUsername" placeholder="Account name or leave blank for AAD" class="form-control" maxlength="256" @bind="sourceUsername" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6">
                            <label for="sourcePassword" class="form-label">Password / AAD Token</label>
                            <div class="input-group">
                                <input type="password" id="sourcePassword" placeholder="Leave blank for auto AAD token" class="form-control" @bind="sourcePassword" @bind:event="oninput" />
                                <div class="input-group-text">
                                    <input type="checkbox" class="form-check-input mt-0 me-1" id="sourceUseAad" @bind="sourceUseAad" />
                                    <label class="form-check-label small" for="sourceUseAad">AAD</label>
                                </div>
                            </div>
                            @if (sourceUseAad)
                            {
                                <small class="text-muted">Token will be fetched automatically via Managed Identity</small>
                            }
                        </div>
                    </div>

                    <!-- Target Connection -->
                    <h6 class="mt-3 mb-2 text-muted">Target (Cassandra MI / OSS)</h6>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <label for="targetConnectionString" class="form-label">Connection String</label>
                            <input type="text" id="targetConnectionString" placeholder="@(NewMode ? "e.g. target-cluster-ip or hostname" : "")" class="form-control" maxlength="1024" @bind="targetConnectionString" />
                        </div>
                        <div class="col-md-4">
                            <label for="targetPort" class="form-label">Port</label>
                            <input type="number" id="targetPort" class="form-control" min="1" max="65535" @bind="targetPort" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="targetUsername" class="form-label">Username</label>
                            <input type="text" id="targetUsername" placeholder="Required for Cassandra MI (leave blank only if target accepts unauthenticated)" class="form-control" maxlength="256" @bind="targetUsername" />
                        </div>
                        <div class="col-md-6">
                            <label for="targetPassword" class="form-label">Password</label>
                            <input type="password" id="targetPassword" placeholder="Required for Cassandra MI (leave blank only if target accepts unauthenticated)" class="form-control" @bind="targetPassword" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="nameSpaces" class="form-label">Tables To Migrate</label>
                        <textarea id="nameSpaces" disabled="@(!NewMode || isFileUploaded)" rows="4" maxlength="1000" placeholder="e.g. keyspace.* (wildcard) or ks1.table1,ks1.table2,ks2.table1 (explicit list). Max 1000 characters, use 'Upload File' for larger text." class="form-control" @bind="namespaces" @oninput="OnTextAreaInput"></textarea>
                        @if (NewMode)
                        {
                            <div class="mt-2">
                                <label for="fileUpload" class="btn btn-sm btn-outline-secondary" style="cursor: pointer;">
                                    <i class="bi bi-upload"></i> Upload File
                                </label>
                                <InputFile id="fileUpload" OnChange="HandleFileUpload" class="d-none" disabled="@isTextAreaUsed" accept=".txt,.json" />
                                @if (isFileUploaded)
                                {
                                    <span class="ms-2 text-success">
                                        <i class="bi bi-check-circle"></i> @uploadedFileName
                                    </span>
                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="ClearFileUpload">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                }
                            </div>
                            @if (isTextAreaUsed && !isFileUploaded)
                            {
                                <small class="text-muted">File upload is disabled when text is entered manually.</small>
                            }
                            else if (isFileUploaded)
                            {
                                <small class="text-muted">Text area is disabled when a file is uploaded.</small>
                            }
                        }
                    </div>
                    <div class="mb-3">
                        <label for="migration-mode" class="form-label" title="Online migration allows live data replication during the process.">
                            Migration Mode
                        </label>                
                        <select id="migration-mode" value="@SelectedMode"  class="form-select" @onchange="OnModeSelectionChanged" disabled="@(!NewMode)">
                            <option value="Offline">Offline</option>
                            <option value="Online">Online</option>
                        </select>
                    </div>
                </div>

                <!-- Advanced Tab Content -->
                <div class="@(activeTab == "Advanced" ? "" : "d-none")">
                    <!-- Advanced Tab Fields -->
                    <div class="mb-3">
                        <label for="logLevel" class="form-label" title="Set the minimum log level for this migration job. Lower levels include more detailed logging.">Log Level</label>
                        <select id="LogLevel" class="form-select" @bind="logLevel" disabled="@(!NewMode)">
                            <option value="@LogType.Error">Error</option>
                            <option value="@LogType.Warning">Warning</option>
                            <option value="@LogType.Info">Info</option>
                            <option value="@LogType.Debug">Debug</option>
                            <option value="@LogType.Verbose">Verbose</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="isSimulatedRun" class="form-label" title="Enable simulated run where no actual writes will occur on the target database.">
                            <input type="checkbox" id="isSimulatedRun" disabled="@(!NewMode)" @bind="isSimulatedRun" />
                            Simulation Mode (No Writes to Target)
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="dropTargetTable" class="form-label" title="Drop target tables before starting migration so they are recreated fresh from source schema.">
                            <input type="checkbox" id="dropTargetTable" disabled="@(!NewMode || skipSchemaSync)" @bind="dropTargetTableBeforeStart" />
                            Drop Target Tables Before Start
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="skipSchemaSync" class="form-label" title="Skip automatic schema sync. The tool will NOT create or modify keyspaces, tables, or User-Defined Types on the target — you must pre-create an identical schema before starting the job. Use this when target schema management is owned by another process or when you only want a subset of UDTs/tables on the target.">
                            <input type="checkbox" id="skipSchemaSync" disabled="@(!NewMode)" @bind="skipSchemaSync" />
                            Skip schema sync (target schema must already exist)
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="skipSourceRowCount" class="form-label" title="Skip the per-table SELECT COUNT(*) probe during partition discovery. Per-table progress shows the live copy rate (e.g. 'Copying (3k/s)') rather than a percentage. Use this when the source is a very large Cassandra cluster where COUNT(*) routinely times out, when the source operator has disabled range scans for cost / blast-radius reasons, or when the cumulative COUNT(*) cost across many tables delays bulk-copy start.">
                            <input type="checkbox" id="skipSourceRowCount" disabled="@(!NewMode)" @bind="skipSourceRowCount" />
                            Don't run COUNT(*) on source (faster start; per-table progress shows live copy rate instead of percent)
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="copyMode" class="form-label" title="Choose how regular (non-counter) tables are copied. 'Preserve TTL & writetime (JSON)' reads via SELECT JSON * and writes via INSERT ... JSON ? USING TIMESTAMP ? AND TTL ?, so the source row's writetime and remaining TTL are preserved (the default v3.x behavior). 'Fast copy (binary)' reads via SELECT * and writes via a typed prepared INSERT — materially faster, but it CANNOT preserve TTL or writetime and is incompatible with per-cell preservation. Counter tables always use the typed UPDATE path regardless of this setting.">
                            Data copy mode (regular tables)
                        </label>
                        <select id="copyMode" class="form-select" disabled="@(!NewMode)" @bind="useJsonCopy" @bind:after="OnCopyModeChanged">
                            <option value="true">Preserve TTL &amp; writetime (JSON copy)</option>
                            <option value="false">Fast copy (binary — no TTL/writetime)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="preserveCellTtl" class="form-label" title="Preserve per-column (per-cell) writetime and TTL instead of a single row-level value. When a row's columns were written at different times or with different TTLs, the row is split into one partial INSERT ... JSON DEFAULT UNSET USING TIMESTAMP ... AND TTL ... per distinct (writetime, TTL) group, so each cell lands on the target with its own timestamp and expiry. Requires the JSON copy mode. Opt-in: the target must support INSERT JSON ... DEFAULT UNSET, and divergent rows issue extra writes. Non-frozen collection element-level TTLs cannot be reconstructed via CQL and still fall back to the row-level TTL. Uniform rows are unaffected.">
                            <input type="checkbox" id="preserveCellTtl" disabled="@(!NewMode || !useJsonCopy)" @bind="preserveCellTtlAndWritetime" />
                            Preserve per-cell TTL and writetime (splits rows with divergent column timestamps/TTLs)
                        </label>
                    </div>
                    @* CQL Copy is the only supported job kind. *@
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="workerCount" class="form-label" title="Size of the shared worker pool that does row-level copy work across all tables. Leave blank for auto = max(MinWorkers, ProcessorCount × WorkerMultiplier).">Shared workers</label>
                                <input type="number" id="workerCount" class="form-control" @bind="workerCount" min="0" max="500" placeholder="@($"Auto ({Math.Max(MigrationDefaults.MinWorkers, Environment.ProcessorCount * MigrationDefaults.WorkerMultiplier)})")"/>
                            </div>
                            <div class="col-md-6">
                                <label for="sourceConnectionsPerHost" class="form-label" title="Source (reader) Cassandra driver connections per host. 0 = driver default.">Source connections per host</label>
                                <input type="number" id="sourceConnectionsPerHost" class="form-control" @bind="sourceConnectionsPerHost" min="0" max="128" placeholder="Driver default"/>
                            </div>
                            <div class="col-md-6">
                                <label for="targetConnectionsPerHost" class="form-label" title="Target (writer) Cassandra driver connections per host. 0 = driver default.">Target connections per host</label>
                                <input type="number" id="targetConnectionsPerHost" class="form-control" @bind="targetConnectionsPerHost" min="0" max="128" placeholder="Driver default"/>
                            </div>
                            <div class="col-md-6">
                                <label for="targetWriteConsistencyLevel" class="form-label" title="Consistency level for regular writes to the target. LOCAL_ONE preserves the historical default; LOCAL_QUORUM provides stronger replica acknowledgement. Counter-table operations always use LOCAL_QUORUM for retry correctness.">Target write consistency</label>
                                <select id="targetWriteConsistencyLevel" class="form-select" @bind="targetWriteConsistencyLevel">
                                    <option value="@TargetWriteConsistencyLevel.LocalOne">LOCAL_ONE (default)</option>
                                    <option value="@TargetWriteConsistencyLevel.One">ONE</option>
                                    <option value="@TargetWriteConsistencyLevel.Two">TWO</option>
                                    <option value="@TargetWriteConsistencyLevel.Three">THREE</option>
                                    <option value="@TargetWriteConsistencyLevel.Quorum">QUORUM</option>
                                    <option value="@TargetWriteConsistencyLevel.LocalQuorum">LOCAL_QUORUM</option>
                                    <option value="@TargetWriteConsistencyLevel.EachQuorum">EACH_QUORUM</option>
                                    <option value="@TargetWriteConsistencyLevel.All">ALL</option>
                                    <option value="@TargetWriteConsistencyLevel.Any">ANY</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="pageSize" class="form-label" title="Rows per page when reading from source. Larger pages reduce round-trips but use more RU per request. Default = 500.">Page size</label>
                                <input type="number" id="pageSize" class="form-control" @bind="pageSize" min="0" max="10000" placeholder="Default (500)"/>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="maxReadRetries" class="form-label" title="Per-page retry count when the source SELECT fails transiently (read timeout, no host available, 429). Default = 3.">Max read retries</label>
                                <input type="number" id="maxReadRetries" class="form-control" @bind="maxReadRetries" min="0" placeholder="Default (3)"/>
                            </div>
                            <div class="col-md-6">
                                <label for="maxWriteRetries" class="form-label" title="Per-row retry count when the target write fails transiently (write timeout, overloaded). Default = 5.">Max write retries</label>
                                <input type="number" id="maxWriteRetries" class="form-control" @bind="maxWriteRetries" min="0" placeholder="Default (5)"/>
                            </div>
                        </div>
                    </div>


                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-2" style="white-space: pre-line">
                        @errorMessage
                        <button type="button" class="btn-close btn-close-sm" aria-label="Close" @onclick="() => errorMessage = string.Empty"></button>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@HandleSubmit">Ok</button>
                <button type="button" class="btn btn-secondary" @onclick="@Cancel">Cancel</button>
            </div>

            
        </div>
    </div>
</div>

@code {


    [Parameter]
    public bool NewMode { get; set; }

    [Parameter]
    public Job? Job { get; set; }

    [Parameter]
    public Func<Job, string, string, Task<bool>>? OnSubmit { get; set; }

    [Parameter]
    public Func<string, Task<bool>>? CheckNameExists { get; set; }

    private string activeTab = "Basic"; // Track active tab
    private string errorMessage = string.Empty;
    private string selectedOption = "CQL Copy"; // Default dropdown value
    private bool isSimulatedRun = false; // Variable to track the dummy run option
    private bool appendMode = false;
    private bool dropTargetTableBeforeStart = false;
    private bool skipSchemaSync = false;
    private bool skipSourceRowCount = false;
    private bool preserveCellTtlAndWritetime = false;
    private bool useJsonCopy = true;
    private int? workerCount = null; // Shared worker pool size (0 = auto from ProcessorCount)
    private int? sourceConnectionsPerHost = null; // Source reader connections per host (0 = auto)
    private int? targetConnectionsPerHost = null; // Target writer connections per host (0 = auto)
    private int? pageSize = null; // Rows per page (0 = default 500)
    private int? maxReadRetries = null; // Per-page source read retries (0 = default 3)
    private int? maxWriteRetries = null; // Per-row target write retries (0 = default 5)
    private TargetWriteConsistencyLevel targetWriteConsistencyLevel = TargetWriteConsistencyLevel.LocalOne;
    private LogType logLevel = LogType.Info; // Minimum log level
    private string namespaces = string.Empty;   // Comma-separated list of namespaces to migrate
    private string name = string.Empty; // Name of the migration job
    private string SelectedMode = "Offline"; // default or loaded value
    private CDCMode cdcMode = CDCMode.Offline;
    private string sourceConnectionString { get; set; } = string.Empty;
    private string targetConnectionString { get; set; } = string.Empty;
    private int sourcePort = 10350;
    private string sourceUsername = string.Empty;
    private string sourcePassword = string.Empty;
    private bool sourceUseAad = false;
    private int targetPort = 9042;
    private string targetUsername = string.Empty;
    private string targetPassword = string.Empty;

    // File upload state
    private bool isFileUploaded = false;
    private bool isTextAreaUsed = false;
    private string uploadedFileName = string.Empty;

    private void OnTextAreaInput(ChangeEventArgs e)
    {
        var value = e?.Value?.ToString() ?? string.Empty;
        isTextAreaUsed = !string.IsNullOrWhiteSpace(value);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file == null)
            {
                return;
            }

            // Limit file size to 10MB
            const long maxFileSize = 10 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                errorMessage = "File size exceeds 10MB limit.";
                return;
            }

            using var stream = file.OpenReadStream(maxFileSize);
            using var reader = new StreamReader(stream);
            namespaces = await reader.ReadToEndAsync();

            isFileUploaded = true;
            uploadedFileName = file.Name;
            isTextAreaUsed = false; // Reset text area flag when file is uploaded
            errorMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading file: {ex.Message}";
        }
    }

    private void ClearFileUpload()
    {
        isFileUploaded = false;
        uploadedFileName = string.Empty;
        namespaces = string.Empty;
        StateHasChanged();
    }

    // Per-cell TTL/writetime preservation requires the JSON copy path.
    // When the user switches to the fast binary path, clear the now-invalid
    // per-cell option so it cannot be submitted in an incompatible state
    // (the checkbox is also disabled in that mode).
    private void OnCopyModeChanged()
    {
        if (!useJsonCopy)
            preserveCellTtlAndWritetime = false;
    }

    private void OnModeSelectionChanged(ChangeEventArgs e)
    {
        var val = e?.Value?.ToString() ?? string.Empty;
        SelectedMode = val;
        cdcMode = val switch
        {
            "Online" => CDCMode.Online,
            _ => CDCMode.Offline
        };
    }

    private void OnSelectionChanged(ChangeEventArgs e)
    {
        selectedOption = e?.Value?.ToString() ?? selectedOption;
    }

    protected override void OnInitialized()
    {
        if (NewMode)
        {
            name = string.Empty;
            sourceConnectionString = string.Empty;
            targetConnectionString = string.Empty;
            namespaces = string.Empty;
            cdcMode = CDCMode.Offline;
            selectedOption = "CQL Copy";
            isSimulatedRun = false;
            appendMode = false;
            dropTargetTableBeforeStart = false;
            skipSchemaSync = false;
            skipSourceRowCount = false;
            preserveCellTtlAndWritetime = false;
            useJsonCopy = true;
            targetWriteConsistencyLevel = TargetWriteConsistencyLevel.LocalOne;
            logLevel = LogType.Info; // Default to Info
            isFileUploaded = false;
            isTextAreaUsed = false;
            uploadedFileName = string.Empty;
        }
        else
        {
            name = Job?.Name ?? string.Empty;
            sourceConnectionString = Job?.SourceContactPoint ?? string.Empty;
            targetConnectionString = Job?.TargetContactPoint ?? string.Empty;
            sourcePort = Job?.SourcePort ?? 10350;
            sourceUsername = Job?.SourceUsername ?? string.Empty;
            sourcePassword = string.Empty;
            sourceUseAad = Job?.SourceUseAad ?? false;
            targetPort = Job?.TargetPort ?? 9042;
            targetUsername = Job?.TargetUsername ?? string.Empty;
            // Same rationale as sourcePassword above.
            targetPassword = string.Empty;
            namespaces = Job?.Namespaces ?? string.Empty;
            cdcMode = Job?.CDCMode ?? CDCMode.Offline;
            selectedOption = "CQL Copy";
            isSimulatedRun = Job?.IsSimulatedRun ?? false;
            appendMode = Job?.AppendMode ?? false;
            dropTargetTableBeforeStart = Job?.DropTargetTableBeforeStart ?? false;
            skipSchemaSync = Job?.SkipSchemaSync ?? false;
            skipSourceRowCount = Job?.SkipSourceRowCount ?? false;
            preserveCellTtlAndWritetime = Job?.PreserveCellTtlAndWritetime ?? false;
            useJsonCopy = Job?.UseJsonCopy ?? true;
            workerCount = Job?.WorkerCount == 0 ? null : Job?.WorkerCount;
            sourceConnectionsPerHost = Job?.SourceMaxConnectionsPerHost == 0 ? null : Job?.SourceMaxConnectionsPerHost;
            targetConnectionsPerHost = Job?.TargetMaxConnectionsPerHost == 0 ? null : Job?.TargetMaxConnectionsPerHost;
            pageSize = Job?.PageSize == 0 ? null : Job?.PageSize;
            maxReadRetries = Job?.MaxReadRetries == 0 ? null : Job?.MaxReadRetries;
            maxWriteRetries = Job?.MaxWriteRetries == 0 ? null : Job?.MaxWriteRetries;
            targetWriteConsistencyLevel = Job?.TargetWriteConsistencyLevel
                ?? TargetWriteConsistencyLevel.LocalOne;
            logLevel = Job?.LogLevel ?? LogType.Info;

            // Set migration mode dropdown value based on CDCMode enum
            SelectedMode = cdcMode switch
            {
                CDCMode.Online => "Online",
                _ => "Offline"
            };
        }
    }

    private async Task HandleSubmit()
    {
        // Aggregate validation problems in a single pass so the
        // operator doesn't fix-submit one field at a time.
        var errors = new List<string>();

        // Normalise the name once; only on create — existing jobs
        // can't edit the field.
        if (NewMode)
        {
            name = (name ?? string.Empty).Trim();
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            errors.Add("Name can't be empty or whitespace.");
        }
        else if (name.Length > 128)
        {
            errors.Add("Name can be at most 128 characters.");
        }
        else if (NewMode && CheckNameExists != null)
        {
            var nameExists = await CheckNameExists(name);
            if (nameExists)
            {
                errors.Add("Name already exists.");
            }
        }

        if (string.IsNullOrEmpty(sourceConnectionString))
        {
            errors.Add("Source Connection String can't be empty.");
        }

        // For simulation mode, add a dummy target connection string if not provided
        if (string.IsNullOrEmpty(targetConnectionString))
        {
            if (isSimulatedRun)
            {
                targetConnectionString = "cassandra://simulation-mode-dummy:9042";
            }
            else
            {
                errors.Add("Target Connection String can't be empty.");
            }
        }

        if (!string.IsNullOrEmpty(sourceConnectionString)
            && sourceConnectionString == targetConnectionString
            && !isSimulatedRun)
        {
            errors.Add("Target and Source Connection Strings can't be the same.");
        }

        if (sourcePort < 1 || sourcePort > 65535)
        {
            errors.Add($"Source Port must be between 1 and 65535 (got {sourcePort}).");
        }
        if (targetPort < 1 || targetPort > 65535)
        {
            errors.Add($"Target Port must be between 1 and 65535 (got {targetPort}).");
        }

        // Mirror the HTML5 min/max on the Advanced tab as a
        // server-side guard (browser caps are trivially bypassed).
        // Allow null = auto/default.
        if (workerCount.HasValue && (workerCount.Value < 0 || workerCount.Value > 500))
        {
            errors.Add($"Shared workers must be between 0 and 500 (got {workerCount.Value}).");
        }
        if (pageSize.HasValue && (pageSize.Value < 1 || pageSize.Value > 10000))
        {
            errors.Add($"Page size must be between 1 and 10000 (got {pageSize.Value}).");
        }
        // Server-side guard against negative retry counts. Upper
        // bound is unbounded by design — operators on flaky endpoints
        // may legitimately opt into many retries.
        if (maxReadRetries.HasValue && maxReadRetries.Value < 0)
        {
            errors.Add($"Max read retries must be 0 or greater (got {maxReadRetries.Value}).");
        }
        if (maxWriteRetries.HasValue && maxWriteRetries.Value < 0)
        {
            errors.Add($"Max write retries must be 0 or greater (got {maxWriteRetries.Value}).");
        }

        // Re-check the maxLength caps the HTML attributes advertise
        // (text inputs default to maxLength=-1).
        if (sourceConnectionString?.Length > 1024)
        {
            errors.Add("Source Connection String can be at most 1024 characters.");
        }
        if (targetConnectionString?.Length > 1024)
        {
            errors.Add("Target Connection String can be at most 1024 characters.");
        }
        if (sourceUsername?.Length > 256)
        {
            errors.Add("Source Username can be at most 256 characters.");
        }
        if (targetUsername?.Length > 256)
        {
            errors.Add("Target Username can be at most 256 characters.");
        }
        if (namespaces?.Length > 1000)
        {
            errors.Add($"Tables To Migrate must be at most 1000 characters (got {namespaces.Length}). Use 'Upload File' for larger lists.");
        }

        if (NewMode)
        {
            var retValue = TableDiscovery.ValidateNamespaceFormat(namespaces);

            if (retValue == null)
            {
                errors.Add("Tables To Migrate: invalid format.");
            }
            else if (!retValue.Item1)
            {
                errors.Add(retValue.Item3);
            }
            else
            {
                namespaces = retValue.Item2;
            }
        }

        if (errors.Count > 0)
        {
            errorMessage = string.Join("\n", errors.Select(e => "• " + e));
            return;
        }


        var job = new Job
        {
            Name = name,
            Id = NewMode ? Guid.NewGuid().ToString() : (Job?.Id ?? Guid.NewGuid().ToString()),
            CDCMode = cdcMode,
            SourceContactPoint = sourceConnectionString,
            SourcePort = sourcePort,
            SourceUsername = sourceUsername,
            SourcePassword = sourcePassword,
            SourceUseAad = sourceUseAad,
            TargetContactPoint = targetConnectionString,
            TargetPort = targetPort,
            TargetUsername = targetUsername,
            TargetPassword = targetPassword,
            Namespaces = namespaces,
            IsSimulatedRun = isSimulatedRun,
            AppendMode = appendMode,
            DropTargetTableBeforeStart = dropTargetTableBeforeStart,
            SkipSchemaSync = skipSchemaSync,
            SkipSourceRowCount = skipSourceRowCount,
            PreserveCellTtlAndWritetime = preserveCellTtlAndWritetime,
            UseJsonCopy = useJsonCopy,
            WorkerCount = workerCount ?? 0,
            SourceMaxConnectionsPerHost = sourceConnectionsPerHost ?? 0,
            TargetMaxConnectionsPerHost = targetConnectionsPerHost ?? 0,
            PageSize = pageSize ?? 0,
            MaxReadRetries = maxReadRetries ?? 0,
            MaxWriteRetries = maxWriteRetries ?? 0,
            TargetWriteConsistencyLevel = targetWriteConsistencyLevel,
            LogLevel = logLevel,
            Tables = new List<TableMigrationSummary>()
        };

        if (NewMode && !string.IsNullOrWhiteSpace(namespaces))
        {
            // Populate Job.Tables from the parsed Tables-To-Migrate
            // input using the same parser the Update Tables modal uses;
            // wildcards stay deferred to the runner.
            try
            {
                var units = await TableDiscovery.PopulateJobTablesAsync(job, namespaces);
                foreach (var u in units)
                {
                    job.Tables.Add(TableMigrationMapper.ToSummary(u));
                    // Persist the per-unit {unitId}.json document up
                    // front so MigrationJobRunner.StartAsync can find
                    // it when iterating job.Tables. Without this,
                    // UnitStore.GetMigrationUnitsToMigrate silently
                    // drops every literal-table entry and the runner
                    // exits with "No remaining migration units."
                    // (wildcard expansion persists per-unit docs at submit).
                    UnitStore.SaveUnit(u, updateParent: false);
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to parse Tables To Migrate: {ex.Message}";
                return;
            }
        }
        if (OnSubmit != null)
        {
            await OnSubmit(job, sourceConnectionString, targetConnectionString);
        }
    }

    private async Task Cancel()
    {
        if (OnSubmit != null)
        {
            await OnSubmit(null, string.Empty, string.Empty);
        }
    }
}
