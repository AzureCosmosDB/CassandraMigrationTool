@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Models
@using CassandraMigrationProcessor.Infrastructure

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>
        <button class="btn btn-light" @onclick="OnGoBack" title="Back to Job List" aria-label="Back to job list" style="border: none; background: transparent;">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </button>
        @Job?.Name - Job Status
    </h3>
    <div class="d-flex align-items-center mb-3">

        @if (IsResumeEnabled && !IsLoadingCollections)
        {
            @* Split button: primary click resumes immediately (mirrors Pause's
               single-click UX); the chevron toggles the dropdown only for the
               "Updated Connection Strings" rotation flow. Previously the whole
               button was a hidden dropdown-toggle with no caret — operators
               clicked it repeatedly with no visible effect because Bootstrap
               just opens/closes the menu instead of taking action. *@
            <div class="btn-group mx-2">
                <button class="btn btn-primary" type="button"
                        disabled="@_resumeInFlight"
                        title="@(IsNeverStarted
                                  ? "Start this job"
                                  : (HasExistingConnectionStrings
                                      ? "Resume with the stored connection strings (single-click)"
                                      : "Resume; connection strings will need to be re-entered"))"
                        @onclick="OnPrimaryResumeClick">
                    <i class="bi bi-play-circle"></i>
                    @(IsNeverStarted ? "Start Job" : "Resume Job")
                </button>
                <button class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                        type="button" id="resumeJobDropdown"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@_resumeInFlight"
                        title="More resume options">
                    <span class="visually-hidden">Toggle Resume Options</span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="resumeJobDropdown">
                    @if (HasExistingConnectionStrings)
                    {
                        <li><button type="button" class="dropdown-item" @onclick="OnResumeWithExistingConnectionString">With Existing Connection Strings</button></li>
                    }
                    <li><button type="button" class="dropdown-item" @onclick="OnResumeWithNewConnectionString">With Updated Connection Strings</button></li>
                </ul>
            </div>
        }

        @if (IsPauseEnabled && !IsLoadingCollections)
        {
            <button class="btn btn-primary mx-2" title="Gracefully pause — active pages complete before stopping" @onclick="OnPauseControlled">
                <i class="bi bi-pause-circle"></i> Pause Job
            </button>
            
            @if (IsControlledPauseRequested && IsRunning)
            {
                <span class="badge bg-warning text-dark mx-2" title="Controlled pause in progress - waiting for active chunks to complete">
                    <i class="bi bi-hourglass-split"></i> Pausing...
                </span>
            }
            
            @if (Job != null && Job.IsOnline)
            {
                var lagInfo = ChangeFeedLag;
                <span class="badge @(lagInfo.IsLow ? "bg-success" : "bg-warning text-dark") me-1"
                      title="Time since last change feed event across all tables">
                    <i class="bi bi-clock-history"></i> Lag: @lagInfo.Display
                </span>
                <button class="btn btn-warning" title="Perform Cut Over — stops change feed and completes migration" disabled="@(!CutoverReady)" @onclick="OnComplete">
                    <i class="bi bi-check2-circle"></i> Cut Over
                </button>
            }

            <button class="btn btn-danger mx-1" title="Cancel this migration permanently" @onclick="OnCancel">
                <i class="bi bi-x-circle"></i> Cancel
            </button>

            <button class="btn btn-toolbar" title="Refresh" aria-label="Refresh job status now" @onclick="OnRefresh">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            </button>

            var autoRefreshOn = Job?.AutoRefreshEnabled ?? true;
            <button class="btn btn-sm @(autoRefreshOn ? "btn-outline-success" : "btn-outline-secondary") ms-2"
                    @onclick="OnToggleAutoRefresh"
                    title="@(autoRefreshOn ? "Auto-refresh is ON - Click to pause UI updates" : "Auto-refresh is OFF - Click to resume UI updates")"
                    aria-label="@(autoRefreshOn ? "Pause auto-refresh" : "Resume auto-refresh")"
                    style="border: 1px solid;">
                <i class="bi @(autoRefreshOn ? "bi-play-fill" : "bi-pause-fill")" aria-hidden="true"></i>
            </button>
        }

    </div>
</div>


@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-2">
        @ErrorMessage
        <button type="button" class="btn-close btn-close-sm" aria-label="Close" @onclick="OnDismissError"></button>
    </div>
}

@code {
    [Parameter] public Job? Job { get; set; }
    [Parameter] public bool IsResumeEnabled { get; set; }
    [Parameter] public bool IsNeverStarted { get; set; }
    [Parameter] public bool IsPauseEnabled { get; set; }
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool IsLoadingCollections { get; set; }
    [Parameter] public bool HasExistingConnectionStrings { get; set; }
    [Parameter] public bool IsControlledPauseApplicable { get; set; }
    [Parameter] public bool IsControlledPauseRequested { get; set; }
    [Parameter] public bool CutoverReady { get; set; }
    [Parameter] public (string Display, bool IsLow) ChangeFeedLag { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;

    [Parameter] public EventCallback OnResumeWithNewConnectionString { get; set; }
    [Parameter] public EventCallback OnResumeWithExistingConnectionString { get; set; }
    [Parameter] public EventCallback OnPauseControlled { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnToggleAutoRefresh { get; set; }
    [Parameter] public EventCallback OnGoBack { get; set; }
    [Parameter] public EventCallback OnDismissError { get; set; }

    /// <summary>
    /// Single-click Resume handler. Defaults to the existing-connection-strings
    /// flow when stored credentials are present (the case 99% of operators hit
    /// after Pause); falls back to the "Updated Connection Strings" flow only
    /// when there is nothing to reuse — that path opens the connection-string
    /// dialog, so a click still produces a visible response.
    /// </summary>
    private bool _resumeInFlight;

    private async Task OnPrimaryResumeClick()
    {
        // In-flight guard: the resume handlers open a dialog with
        // await Task.Delay before any state mutation; without this
        // gate a fast double-click can fire two parallel
        // Task.Run(StartMigration) calls before IsResumeEnabled
        // flips. Promoting to a single primary click materially
        // increases that risk vs the prior dropdown shape.
        if (_resumeInFlight) return;
        _resumeInFlight = true;
        try
        {
            if (HasExistingConnectionStrings)
                await OnResumeWithExistingConnectionString.InvokeAsync();
            else
                await OnResumeWithNewConnectionString.InvokeAsync();
        }
        finally
        {
            _resumeInFlight = false;
        }
    }
}
