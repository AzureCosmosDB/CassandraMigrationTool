@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Models

<div class="modal fade show d-block bg-dark bg-opacity-75" id="myModal" aria-modal="true" role="dialog">
    <div class="modal-dialog bg-dark">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Configuration Settings</h4>
                <button type="button" class="btn-close" aria-label="Close" @onclick="@Cancel"></button>
            </div>
            <div class="modal-body">
                <!-- Tab Navigation. The previous "Online / ChangeStream"
                     tab was intentionally removed in v2: every online-pipeline
                     knob (poll interval, parallelism, replay-batch sizing) is
                     now sourced from AppSettings + per-job Job.* fields and
                     surfaced on the Job form, so this dialog only carries the
                     handful of true app-level settings. Do not reintroduce
                     the tab without first confirming there is a setting that
                     belongs here. -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == OfflineDataMovementTab ? "active" : "")" @onclick="@(() => activeTab = OfflineDataMovementTab)">Offline</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == OtherTab ? "active" : "")" @onclick="@(() => activeTab = OtherTab)">Other</button>
                    </li>
                </ul>

                <!-- Offline Data Movement Tab Content -->
                <div class="@(activeTab == OfflineDataMovementTab ? "" : "d-none")">
                    <div class="mb-3">
                        <label for="cql-copy-page-size" class="form-label">CQL Copy page size</label>
                        <input type="number" id="cql-copy-page-size" class="form-control" @bind="(_configurationBackup ??= new AppSettings()).CqlCopyPageSize" />
                    </div>
                </div>

                <!-- Other Tab Content -->
                <div class="@(activeTab == OtherTab ? "" : "d-none")">
                    <div class="mb-3">
                        <label for="log-page-size" class="form-label">Log page size</label>
                        <input type="number" id="log-page-size" class="form-control" min="1000" max="100000" @bind="(_configurationBackup ??= new AppSettings()).LogPageSize" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-2">
                        @errorMessage
                        <button type="button" class="btn-close btn-close-sm" aria-label="Close" @onclick="() => errorMessage = string.Empty"></button>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick=@HandleSubmit>OK</button>
                <button type="button" class="btn btn-secondary" @onclick="@Cancel">Cancel</button>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public AppSettings? _configuration { get; set; }

    [Parameter]
    public EventCallback<AppSettings?> On_configurationSaved { get; set; }

    private string errorMessage = string.Empty;
    private const string OfflineDataMovementTab = "OfflineDataMovement";
    private const string OtherTab = "Other";
    private string activeTab = OfflineDataMovementTab;

    AppSettings? _configurationBackup;

    protected override void OnInitialized()
    {
        _configurationBackup = _configuration?.Copy() ?? new AppSettings();
    }

    private async Task HandleSubmit()
    {
        if ((_configurationBackup?.LogPageSize ?? 0) < 1000 || (_configurationBackup?.LogPageSize ?? 0) > 100000)
        {
            errorMessage = "Log page size should be between 1000 and 100000.";
            return;
        }

        if ((_configurationBackup?.CqlCopyPageSize ?? 0) < 50 || (_configurationBackup?.CqlCopyPageSize ?? 0) > 40000)
        {
            errorMessage = "Page size should be between 50 and 40000.";
            return;
        }

        _configurationBackup ??= new AppSettings();
        _configuration = _configurationBackup.Copy();

        if (On_configurationSaved.HasDelegate)
        {
            await On_configurationSaved.InvokeAsync(_configuration);
        }
    }

    private async Task Cancel()
    {
        if (On_configurationSaved.HasDelegate)
        {
            await On_configurationSaved.InvokeAsync(null);
        }
    }
}