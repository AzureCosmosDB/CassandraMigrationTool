@using CassandraMigrationProcessor

<div class="modal fade show d-block bg-dark bg-opacity-75" id="myModal" aria-modal="true" role="dialog">
    <div class="modal-dialog bg-dark modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Table Details</h4>
                <button type="button" class="btn-close" aria-label="Close" @onclick="@Cancel"></button>
            </div>
            <div class="modal-body">
                @if (TableMigration is not null)
                {
                    <style>
                        .cd-table { table-layout: fixed; width: 100%; font-size: .9rem; }
                        .cd-table th, .cd-table td { vertical-align: top; padding: .35rem .5rem; }
                        .cd-col-label { width: 20ch; white-space: nowrap; }
                        /* Show full values without trimming */
                        .group div { line-height: 1.3; white-space: normal; overflow: visible; text-overflow: clip; word-break: break-word; overflow-wrap: anywhere; }
                        .lbl { color: #666; }
                        @@media (max-width: 768px) { .modal-dialog { max-width: 98vw; } }
                        /* Allow scrolling if content is very long */
                        .modal-body { max-height: 78vh; overflow: auto; }
                    </style>

                    <table class="table table-bordered table-striped cd-table">
                        
                        <tbody>
                            <tr>
                                <td class="cd-col-label">General</td>
                                <td class="group">
                                    <div><span class="lbl">Keyspace:</span> @TableMigration.KeyspaceName</div>
                                    <div><span class="lbl">Table:</span> @TableMigration.TableName</div>
                                    @if (HasTargetNamespaceMapping(TableMigration))
                                    {
                                        <div><span class="lbl">Target Namespace:</span> @GetTargetNamespace(TableMigration)</div>
                                    }
                                    <div><span class="lbl">Source Status:</span> @TableMigration.SourceStatus</div>
                                    <div><span class="lbl">Initial Estimate:</span> @FormatLong(TableMigration.EstimatedRowCount)</div>
                                    <div><span class="lbl">Before Copying:</span> @FormatLong(TableMigration.ActualRowCount)</div>
                                    <div><span class="lbl">While Processing:</span> @FormatLong(TableMigration.SourceCountDuringCopy)</div>
                                </td>
                            </tr>

                            <tr>
                                <td class="cd-col-label">Offline Copy</td>
                                <td class="group">
                                    <div><span class="lbl">Started On (UTC):</span> @(TableMigration.BulkCopyStartedOn?.ToString() ?? "N/A")</div>
                                    <div><span class="lbl">Ended On (UTC):</span> @(TableMigration.BulkCopyEndedOn?.ToString() ?? "N/A")</div>
                                    <div><span class="lbl">Duration:</span> @GetDuration(TableMigration.BulkCopyStartedOn, TableMigration.BulkCopyEndedOn)</div>
                                    @{
                                        var totals = TableMigration.GetProcessedTotals();
                                    }
                                    <div><span class="lbl">Processed Total:</span> @FormatLong(totals.Total)</div>
                                    <div><span class="lbl">Insert:</span> @FormatLong(totals.Inserted)</div>
                                    <div><span class="lbl">Failed:</span> @FormatLong(totals.Failed)</div>
                                </td>
                            </tr>

                            <tr>
                                <td class="cd-col-label">Change Feed</td>
                                <td class="group">
                                    @if (Job != null && Job.IsOnline)
                                    {
                                        <div><span class="lbl">Started On (UTC):</span> @(TableMigration.ChangeFeedStartedOn?.ToString() ?? "N/A")</div>
                                        <div><span class="lbl">Continuation Token:</span> @(TableMigration.ChangeFeedContinuationToken ?? "N/A")</div>
                                        <div><span class="lbl">Inserted:</span> @FormatLong(TableMigration.ChangeFeedRowsInserted) (from @FormatLong(TableMigration.ChangeFeedInsertEvents) events)</div>
                                        <div><span class="lbl">Deleted:</span> @FormatLong(TableMigration.ChangeFeedRowsDeleted) (from @FormatLong(TableMigration.ChangeFeedDeleteEvents) events)</div>
                                        <div><span class="lbl">Updated:</span> @FormatLong(TableMigration.ChangeFeedRowsUpdated) (from @FormatLong(TableMigration.ChangeFeedUpdateEvents) events)</div>
                                        <div><span class="lbl">Failed (with retries):</span> @FormatLong(TableMigration.ChangeFeedErrors)</div>
                                        <div><span class="lbl">Avg Read Latency (ms):</span> @TableMigration.ChangeFeedAvgReadLatencyInMS.ToString("F2")</div>
                                        <div><span class="lbl">Avg Write Latency (ms):</span> @TableMigration.ChangeFeedAvgWriteLatencyInMS.ToString("F2")</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Not an online migration.</div>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted">No properties found.</div>
                }

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@Cancel">Close</button>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public TableMigration? TableMigration { get; set; }

    [Parameter]
    public Job? Job { get; set; }


    [Parameter]
    public EventCallback OnClose { get; set; }

    

    private static string GetDuration(DateTime? start, DateTime? end)
    {
        if (!start.HasValue || !end.HasValue || start.Value == DateTime.MinValue || end.Value == DateTime.MinValue)
            return "N/A";
        var d = end.Value - start.Value;
        return $"{(int)d.TotalHours}h {d.Minutes}m {d.Seconds}s";
    }

    private static bool HasTargetNamespaceMapping(TableMigration TableMigration)
    {
        return !string.Equals(TableMigration.KeyspaceName, TableMigration.GetEffectiveTargetKeyspaceName(), StringComparison.OrdinalIgnoreCase)
            || !string.Equals(TableMigration.TableName, TableMigration.GetEffectiveTargetTableName(), StringComparison.OrdinalIgnoreCase);
    }

    private static string GetTargetNamespace(TableMigration TableMigration)
    {
        return $"{TableMigration.GetEffectiveTargetKeyspaceName()}.{TableMigration.GetEffectiveTargetTableName()}";
    }

    private static string FormatLong(long value) => string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N0}", value);

    private void Cancel()
    {
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
    }
}
