<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block" id="myModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Caption</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="@Cancel"></button>
            </div>
            <div class="modal-body">
                <p>@Message</p>
            </div>
            <div class="modal-footer">
                @{
                    var btns = GetButtons(Type);
                }
                <button type="button" class="@btns.OkClass" @onclick=@Ok>@btns.OkLabel</button>
                @if (btns.CancelLabel != null)
                {
                    <button type="button" class="btn btn-secondary" @onclick="@Cancel">@btns.CancelLabel</button>
                }
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<YesNoDialogResult> OnClose { get; set; }
    [Parameter] public Category Type { get; set; }

    private Task Cancel()
    {
        
        return OnClose.InvokeAsync(new YesNoDialogResult { IsConfirmed = false, DiaLogType = Type });
    }

    private Task Ok()
    {
        return OnClose.InvokeAsync(new YesNoDialogResult { IsConfirmed = true, DiaLogType = Type });
    }

    public enum Category
    {
        Okay,
        CutoverNot,
        CompleteNot,
        SyncBackNot,
        DeleteNot,
        RecoverNot,
        RunComparisonNot,
        CancelNot

    }

    private sealed record DialogButtons(string OkLabel, string OkClass, string? CancelLabel);

    private const string PrimaryBtn = "btn btn-primary";

    private static DialogButtons GetButtons(Category c) => c switch
    {
        Category.Okay             => new("OK",              PrimaryBtn,         null),
        Category.CutoverNot       => new("Cutover",         PrimaryBtn,         "Don't Cutover"),
        Category.CompleteNot      => new("Complete",        PrimaryBtn,         "Don't Complete"),
        Category.SyncBackNot      => new("Start Sync Back", PrimaryBtn,         "Don't Cutover"),
        Category.DeleteNot        => new("Delete",          PrimaryBtn,         "Don't Delete"),
        Category.RecoverNot       => new("Recover",         PrimaryBtn,         "Don't Recover"),
        Category.RunComparisonNot => new("Run Comparison",  PrimaryBtn,         "Don't Run Comparison"),
        Category.CancelNot        => new("Cancel Job",      "btn btn-danger",   "Keep Running"),
        _                         => new("OK",              PrimaryBtn,         null),
    };

    public class YesNoDialogResult
    {
        public bool IsConfirmed { get; set; }
        public Category DiaLogType { get; set; }
    }
}
