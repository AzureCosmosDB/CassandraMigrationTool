@page "/"
@inject Service.JobManager JobManager
@inject CassandraMigrationProcessor.Context.MigrationJobContext MigrationContext
@inject NavigationManager NavigationManager

@using CassandraMigrationWebApp.Components
@using CassandraMigrationWebApp.Service
@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Infrastructure
@using CassandraMigrationProcessor.Models


<div class="card" style="border: none; box-shadow: none; background: transparent;">
    <div style="background: var(--az-surface, #fff); border-bottom: 1px solid var(--az-border, #d6d6d6); padding: 10px 16px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: center; border-radius: 4px 4px 0 0;">
        <div style="font-size: 18px; font-weight: 600; color: var(--az-text, #323130);">
            Migration Jobs
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" title="Create a new migration job" aria-label="New migration job" @onclick="StartMigrationAsync">
                <i class="bi bi-plus" aria-hidden="true"></i> New
            </button>
            <button class="btn btn-outline-secondary btn-sm" title="Application settings" aria-label="Application settings" @onclick="OpenConfig">
                <i class="bi bi-gear" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@if (_loadingComplete)
{
    @if (migrationJobs?.Count == 0)
    {
        <div class="card">
            <div class="card-body empty-collections-state">
                <i class="bi bi-database-add d-block"></i>
                <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px; color: var(--az-text, #323130);">No migration jobs</div>
                <div style="font-size: 13px; color: var(--az-text-secondary, #605e5c); margin-bottom: 16px;">Create a migration job to get started.</div>
                <button class="btn btn-primary btn-sm" @onclick="StartMigrationAsync">
                    <i class="bi bi-plus me-1"></i> Create job
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card" style="overflow: hidden;">
            <div style="overflow-x: auto;">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width:32px;"></th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Started</th>
                            <th>Duration</th>
                            <th>Source → Target</th>
                            <th>Mode</th>
                            <th>Progress</th>
                            <th>ETA</th>
                            <th>Status</th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var migration in GetMigrations())
                        {
                            <tr style="cursor: pointer;" @onclick="() => ViewMigration(migration.Id)">
                                <td class="text-center" style="padding: 8px 4px;">
                                    @if (JobManager.IsProcessRunning(migration.Id ?? string.Empty))
                                    {
                                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background: var(--az-success, #107c10);" title="Running"></span>
                                    }
                                    else
                                    {
                                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background: var(--az-border, #d6d6d6);"></span>
                                    }
                                </td>
                                <td>
                                    <span style="color: var(--az-brand, #0078d4); font-weight: 600;">@migration.Name</span>
                                </td>
                                <td style="color: var(--az-text-secondary, #605e5c);">@GetToolName(migration.JobType)</td>
                                <td style="color: var(--az-text-secondary, #605e5c); font-size: 12px;">@migration.StartedOn</td>
                                <td style="color: var(--az-text-secondary, #605e5c); font-size: 12px; white-space: nowrap;" title="@GetDurationTooltip(migration)">
                                    @GetJobDuration(migration)
                                </td>
                                <td style="font-size: 12px; max-width: 260px;" title="@GetToolTip(migration)">
                                    <div class="text-truncate" style="color: var(--az-text, #323130);">@migration.SourceContactPoint</div>
                                    <div class="text-truncate" style="color: var(--az-text-disabled, #a19f9d); font-size: 11px;">→ @migration.TargetContactPoint</div>
                                </td>
                                <td>
                                    @if (migration.IsOnline)
                                    {
                                        <span class="badge bg-light text-dark border border-info">Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border border-secondary">Offline</span>
                                    }
                                </td>
                                <td style="font-size: 12px; white-space: nowrap;">
                                    @{
                                        long copiedRows = migration.Tables?.Sum(mu => mu.CopyRowsCopied) ?? 0;
                                        long totalDocs = migration.Tables?.Sum(mu => mu.TotalRowCount) ?? 0;
                                    }
                                    @if (totalDocs > 0)
                                    {
                                        <span title="Rows copied / Total documents">@copiedRows.ToString("N0") / @totalDocs.ToString("N0")</span>
                                    }
                                    else if (copiedRows > 0)
                                    {
                                        <span>@copiedRows.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--az-text-disabled, #a19f9d);">—</span>
                                    }
                                </td>
                                <td style="font-size: 12px; white-space: nowrap;">
                                    @{
                                        double speed = migration.Tables?
                                            .Where(mu => mu.CopyRowsPerSecond > 0)
                                            .Select(mu => mu.CopyRowsPerSecond)
                                            .DefaultIfEmpty(0).Sum() ?? 0;
                                        long remaining = totalDocs - copiedRows;
                                    }
                                    @if (speed > 0 && remaining > 0)
                                    {
                                        <span>@JobLifecycle.FormatEta(remaining, speed)</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--az-text-disabled, #a19f9d);">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var liveStatus = JobManager.GetLiveStatus(migration);
                                    }
                                    <span class="badge @JobLifecycle.BadgeClass(liveStatus)">@JobLifecycle.Label(liveStatus)</span>
                                </td>
                                <td @onclick:stopPropagation="true">
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-outline-secondary btn-sm" title="View job details" aria-label="View job details" @onclick="() => ViewMigration(migration.Id)">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" title="Open job report" aria-label="Open job report" @onclick="() => ViewJobReport(migration.Id)">
                                            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" title="Delete job" aria-label="Delete job" @onclick="() => RemoveMigration(migration.Id)">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_migrationDetailsPopUpOpen)
{
    <MigrationDetails NewMode=true OnSubmit="@OnMigrationDetailsPopUpSubmit" CheckNameExists="CheckIfNameExistsAsync" />
}

@if (_yesNoDialogOpen)
{
    <YesNoDialog Type="YesNoDialog.Category.DeleteNot" Caption="Confirm Delete" Message="@_message" OnClose="@YesNoDialogSubmit" />
}


@if (_messageDialogOpen)
{
    <YesNoDialog Type="YesNoDialog.Category.Okay" Caption="Message" Message="@_message" OnClose="@YesNoDialogSubmit" />
}

@if (_editSettingsOpen)
{
    <MigrationSettings _configuration="@GetConfig()" On_configurationSaved="HandleConfigurationSaved" />
}

@code {
    #pragma warning disable CS8603
#pragma warning disable CS8604
#pragma warning disable CS8600

    private bool _migrationDetailsPopUpOpen;
    private bool _yesNoDialogOpen;
    private bool _messageDialogOpen;
    private bool _editSettingsOpen;

    private string _message = string.Empty;
    private Job? _selectedMigrationJob;
    private List<Job>? migrationJobs;
    private bool _loadingComplete;

    private string GetToolTip(Job Job)
    {

        return string.Join(",",
            Job.Tables?
                .Select(mu => $"{mu.KeyspaceName}.{mu.TableName}") ?? Enumerable.Empty<string>());
    }


    private string GetToolName(CassandraMigrationProcessor.Models.JobType jobType)
    {
        switch(jobType)
        {
            case CassandraMigrationProcessor.Models.JobType.CqlCopy:
                return "CQL Copy";
            default:
                return "NA";
        }
    }

    private string GetJobDuration(Job migration)
    {
        if (!migration.StartedOn.HasValue || migration.StartedOn.Value == DateTime.MinValue)
            return "—";

        var endTime = ResolveJobEndTime(migration);
        var elapsed = endTime - migration.StartedOn.Value;
        if (elapsed.TotalSeconds < 1) return "—";
        return FormatElapsed(elapsed);
    }

    private string GetDurationTooltip(Job migration)
    {
        if (!migration.StartedOn.HasValue || migration.StartedOn.Value == DateTime.MinValue)
            return "Job has not started yet";

        if (JobManager.IsProcessRunning(migration.Id ?? string.Empty))
            return $"Running for {FormatElapsed(DateTime.UtcNow - migration.StartedOn.Value)} (live)";

        var endTime = ResolveJobEndTime(migration);
        return migration.Status switch
        {
            JobStatus.Completed => $"Completed at {endTime:yyyy-MM-dd HH:mm:ss} UTC",
            JobStatus.Faulted   => $"Last activity at {endTime:yyyy-MM-dd HH:mm:ss} UTC (job is Faulted; clock stopped here)",
            JobStatus.Cancelled => $"Last activity at {endTime:yyyy-MM-dd HH:mm:ss} UTC (job was Cancelled)",
            JobStatus.Paused    => $"Last activity at {endTime:yyyy-MM-dd HH:mm:ss} UTC (job is Paused)",
            _                   => $"Last activity at {endTime:yyyy-MM-dd HH:mm:ss} UTC",
        };
    }

    private DateTime ResolveJobEndTime(Job migration)
    {
        // Running jobs always show elapsed wall-clock time so the duration
        // ticks forward; this matches operator expectation ("how long has
        // this been running?"). Without this, Faulted jobs would freeze
        // the duration at the moment of the last successful batch
        // (e.g. ~15s into a 19-min run), making the operator think the
        // crash happened ~15s in when actually the worker died silently
        // 19 minutes ago.
        if (JobManager.IsProcessRunning(migration.Id ?? string.Empty))
            return DateTime.UtcNow;

        if (migration.EndedOn.HasValue)
            return migration.EndedOn.Value;

        // For non-running jobs without a terminal stamp (legacy job docs
        // that pre-date EndedOn, or Paused jobs), prefer the most recent
        // per-table CDC activity so Faulted/Completed/Cancelled jobs
        // reflect "ran for X" not just "started X ago".
        DateTime? lastActivity = null;
        foreach (var t in migration.Tables ?? new List<TableMigrationSummary>())
        {
            if (t.ChangeFeedLastChecked.HasValue && (!lastActivity.HasValue || t.ChangeFeedLastChecked.Value > lastActivity.Value))
                lastActivity = t.ChangeFeedLastChecked.Value;
        }

        // If we never recorded any activity (e.g. offline job that
        // crashed before any CDC checkpoint), fall back to wall-clock.
        // This is conservative but it's still much better than a
        // misleading "15s" report — the duration at least monotonically
        // reflects "how long the job has been alive on disk" instead of
        // freezing on the first batch.
        return lastActivity ?? DateTime.UtcNow;
    }

    private static string FormatElapsed(TimeSpan d)
    {
        if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}s";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h {d.Minutes}m";
        return $"{(int)d.TotalDays}d {d.Hours}h";
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

#pragma warning disable CS1998
    protected override async Task OnParametersSetAsync()
    {
        if (_loadingComplete)
            return;

        _loadingComplete = false;
        migrationJobs = GetMigrations();
        _loadingComplete = true;
    }
#pragma warning restore CS1998
#pragma warning disable CS8602

    private List<Job> GetMigrations()
    {
        var ids = JobManager.GetMigrationIds();
        var result = MigrationContext.GetJobsById(ids);
        // Latest jobs first
        result.Reverse();
        return result;
    }


    private void RemoveMigration(string? id)
    {
        _selectedMigrationJob = JobManager.GetMigrationJobById(id);       
        if (!JobManager.IsProcessRunning(id ?? string.Empty))
        {
            _message = "Are you sure you want to delete " + _selectedMigrationJob?.Name + " ?";
            _yesNoDialogOpen = true;
        }
        else
        {
            _message = "Can't delete active job " + _selectedMigrationJob?.Name + ". Please stop the job and try again.";
            _messageDialogOpen = true;
        }
    }

    private void YesNoDialogSubmit(YesNoDialog.YesNoDialogResult result)
    {
        if (_messageDialogOpen)
        {
            _messageDialogOpen = false;
            return;
        }
        else
        {
            _yesNoDialogOpen = false;


            if (result.IsConfirmed && (!JobManager.IsProcessRunning(_selectedMigrationJob?.Id ?? string.Empty)))
            {

                if (_selectedMigrationJob != null)
                {
                    string jobId = _selectedMigrationJob.Id;

                    try
                    {
                        JobManager.ClearJobFiles(jobId);
                    }
                    catch (Exception ex)
                    {
                        Console.Error.WriteLine(
                            $"ClearJobFiles({jobId}) failed: {ex.GetType().Name}: {ex.Message}");
                    }
                }

            }

            _selectedMigrationJob = null;
        }
    }

    private CassandraMigrationProcessor.Models.AppSettings GetConfig()
    {
        return JobManager.GetConfig();
    }



    private void OpenConfig()
    {
        _editSettingsOpen = true;
    }

    private void HandleConfigurationSaved(CassandraMigrationProcessor.Models.AppSettings updatedConfig)
    {
        _editSettingsOpen = false;

        if (updatedConfig != null)
        {            
            if (!JobManager.UpdateConfig(updatedConfig, out string errorMessage))
            {
                _message = errorMessage;
                _messageDialogOpen = true;
            }
        }
    }

    private void ViewMigration(string? id)
    {

        NavigationManager.NavigateTo($"/MigrationJobViewer/{id}");
    }

    private void ViewJobReport(string? id)
    {
        NavigationManager.NavigateTo($"/jobreport/{id}");
    }

    private void StartMigrationAsync()
    {
        _selectedMigrationJob = null;
        _migrationDetailsPopUpOpen = true;
    }

    private Task<bool> CheckIfNameExistsAsync(string name)
    {
        var Job = GetMigrations().Find(m => m.Name == name);
        return Task.FromResult(Job != null);
    }

    private async Task<bool> OnMigrationDetailsPopUpSubmit(Job job, string sourceConnectionString, string targetConnectionString)
    {
        _migrationDetailsPopUpOpen = false;
        if (job != null)
        {
            if (_selectedMigrationJob == null)
            {
                // Store connection strings if provided
                if (!string.IsNullOrEmpty(sourceConnectionString))
                    MigrationContext.Credentials.SetSource(job.Id, sourceConnectionString);

                if (!string.IsNullOrEmpty(targetConnectionString))
                    MigrationContext.Credentials.SetTarget(job.Id, targetConnectionString);

                MigrationContext.JobIndex.MigrationJobIds.Add(job.Id);

                MigrationContext.PendingAutoStartJobIds.TryAdd(job.Id, 0);
                MigrationContext.SaveMigrationJob(job);
                MigrationContext.SaveJobList();
                
                ViewMigration(job.Id);
            }
        }
        await InvokeAsync(StateHasChanged);
        return true;
    }
}
