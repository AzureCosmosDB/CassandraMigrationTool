    /// <summary>
    /// Compute the max change-feed lag across all tables.
    /// Returns a display string and a flag indicating
    /// whether the lag is low enough for cutover.
    /// </summary>
    private (string Display, bool IsLow) GetChangeFeedLag()
    {
        if (CurrentlyLoadedMigrationJob?.MigrationUnitBasics == null)
            return ("N/A", false);

        var mus = CurrentlyLoadedMigrationJob.MigrationUnitBasics
            .Where(mu => mu.ChangeFeedLastChecked.HasValue)
            .ToList();

        if (mus.Count == 0)
            return ("waiting...", false);

        var maxLag = mus
            .Select(mu => DateTime.UtcNow - mu.ChangeFeedLastChecked!.Value)
            .Max();

        string display;
        if (maxLag.TotalMinutes < 1)
            display = $"{(int)maxLag.TotalSeconds}s";
        else if (maxLag.TotalHours < 1)
            display = $"{(int)maxLag.TotalMinutes}m {maxLag.Seconds}s";
        else
            display = $"{(int)maxLag.TotalHours}h {maxLag.Minutes}m";

        // Consider "low" if under 30 seconds
        bool isLow = maxLag.TotalSeconds < 30;
        return (display, isLow);
    }

