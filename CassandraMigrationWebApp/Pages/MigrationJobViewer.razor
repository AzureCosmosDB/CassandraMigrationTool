            // Only auto-start if connection strings are
            // available (new job from Index page). Old jobs
            // after restart won't have connection strings.
            if (CanAutoStart())
            {
                await ResumeJob();
            }
            else if (CurrentlyLoadedMigrationJob != null
                && CurrentlyLoadedMigrationJob.IsStarted
                && !CurrentlyLoadedMigrationJob.IsCompleted
                && !NoOtherActiveJobs())
            {
                // BB-1 fix: Tell user why job can't start
                string activeId = JobManager?.GetRunningJobId() ?? string.Empty;
                var activeJob = !string.IsNullOrEmpty(activeId)
                    ? MigrationJobContext.GetMigrationJob(activeId)
                    : null;
                string activeName = activeJob?.Name ?? activeId;
                _errorMessage = $"Another migration job \"{activeName}\" is currently running. "
                    + "This job will start automatically when the active job completes, "
                    + "or you can use 'Resume Job' after pausing/completing the active job.";
            }
            var mjLocal = CurrentlyLoadedMigrationJob;
            if (mjLocal != null && !mjLocal.IsCancelled && !mjLocal.IsCompleted)
            {
                StartAutoRefresh();
            }
        }        
    }

    private async Task<bool> OnMigrationDetailsPopUpSubmit(MigrationJob? job, string sourceConnectionString, string targetConnectionString)
    {
        _migrationDetailsPopUpOpen = false;
        await Task.Delay(100);

        if (job == null || CurrentlyLoadedMigrationJob == null)
        {
            await InvokeAsync(StateHasChanged);
            return false;
        }

        // Capture in a local variable — CurrentlyLoadedMigrationJob
        // is a getter that may return different instances each call
        // when the job isn't yet the active job in context.
        var mj = CurrentlyLoadedMigrationJob;

        if (!string.IsNullOrEmpty(sourceConnectionString))
            MigrationJobContext.SourceConnectionString[mj.Id] = sourceConnectionString;

        if (!string.IsNullOrEmpty(targetConnectionString))
            MigrationJobContext.TargetConnectionString[mj.Id] = targetConnectionString;

        mj.Status = JobStatus.Running;

        if (!mj.StartedOn.HasValue)
            mj.StartedOn = DateTime.UtcNow;

        // Clear pending auto-start flag so it doesn't fire again
        MigrationJobContext.PendingAutoStartJobIds.TryRemove(mj.Id, out _);

        MigrationJobContext.SaveMigrationJob(mj);
        MigrationJobContext.SaveJobList();


        // Check if we should show the loading spinner
        if (mj.MigrationUnitBasics == null || mj.MigrationUnitBasics.Count == 0)
        {
            _isLoadingCollections = true;
            await InvokeAsync(StateHasChanged);
        }

        // Fire-and-forget: Run the long task on a separate thread without blocking
        _ = Task.Run(async () =>
        {
            // JobManager.DisposeLogs();

            await JobManager.StartMigration(mj,
                GetSourceConnectionString(mj),
                GetTargetConnectionString(mj),
                mj.NameSpaces ?? string.Empty,
                mj.JobType,
                Helper.IsOnline(mj));
        });

        StartAutoRefresh();
        return true;
    }

    private void ResetChangeStream()
    {
        _errorMessage = string.Empty;

        if (IsResumeEnabled())
        {
            _resetChangeStreamDialogOpen = true;
        }
        else
        {
            _errorMessage = "Please pause the job before resetting change stream.";
        }
    }
    private void ManageCollections()
    {
        _errorMessage = string.Empty;

        // Check if SourceConnectionString is blank
        if (string.IsNullOrWhiteSpace(GetSourceConnectionString(CurrentlyLoadedMigrationJob)))
        {
            _errorMessage = "Source connection string is not available. Please use 'Resume Job' → 'With Updated Connection Strings' to provide connection details, then pause the job before updating collections.";
            return;
        }

        if (IsResumeEnabled())
        {
            _manageCollectionDialogOpen = true;
        }
        else
        {
            _errorMessage = "Please pause the job before updating collections.";
        }
    }
    private async Task ResumeJobWithNewConnectionString()
    {
        await DecideAndResumeJob(true);
    }

    private async Task ResumeJobWithExistingConnectionString()
    {
        if (IsResumeEnabled() && NoOtherActiveJobs())
        {
            if (CurrentlyLoadedMigrationJob != null)
                await OnMigrationDetailsPopUpSubmit(CurrentlyLoadedMigrationJob, string.Empty, string.Empty);
            else
                _migrationDetailsPopUpOpen = true;
        }
        else
            _migrationDetailsPopUpOpen = true;
    }

    private async Task ResumeJob()
    {
        await DecideAndResumeJob(false);
    }

    private async Task DecideAndResumeJob(bool showDialog=false)
    {
        _errorMessage = string.Empty;
        if (IsResumeEnabled() && NoOtherActiveJobs())
        {
            if(showDialog)
                _migrationDetailsPopUpOpen = true;
            else
            {
                if (CanAutoStart())
                {
                    if (CurrentlyLoadedMigrationJob != null)
                        await OnMigrationDetailsPopUpSubmit(CurrentlyLoadedMigrationJob, string.Empty, string.Empty);
                }

            }
        }
        else
        {
            _errorMessage = "Please stop active job, before starting/resuming a job.";
        }
    }

    private bool IsJobRunning()
    {
        if (JobManager.IsProcessRunning(JobId))
            return true;

        // BB-2 fix: After page refresh, double-check the
        // static ActiveMigrationJobId in case the singleton
        // JobManager's state is stale for this job ID.
        if (MigrationJobContext.ActiveMigrationJobId == JobId)
        {
            var job = CurrentlyLoadedMigrationJob;
            if (job != null && !job.IsCancelled && !job.IsCompleted)
            {
                // Verify the worker thread is actually alive
                // by checking _runningJobId on JobManager
                string runningId = JobManager?.GetRunningJobId() ?? string.Empty;
                if (runningId == JobId)
                    return true;
            }
        }

        return false;
    }

    private void CompleteJob()
    {
        _message = "You can't resume a job after its cutover. Are you sure you want to cutover?";
        _yesNoDiaLogType = YesNoDialog.Category.CutoverNot;
        _yesNoDialogOpen = true;
    }

    // BB-5: Cancel/abort a running migration permanently
    private void ConfirmCancelJob()
    {
        _message = "This will permanently cancel the migration. You will not be able to resume it. Continue?";
        _yesNoDiaLogType = YesNoDialog.Category.CancelNot;
        _yesNoDialogOpen = true;
    }


    private void HandleCollectionDetailsClose()
    {
        _collectionDetailsDialogOpen = false;
        _selectedMigrationUnit = null;     
    }

    private void OnCSReset(List<MigrationUnit> migrationUnits)
    {
        _resetChangeStreamDialogOpen = false;
    }


    private async Task OnCollectionsUpdated(List<MigrationUnit> migrationUnits)
    {
        _manageCollectionDialogOpen = false;

        if (migrationUnits != null && CurrentlyLoadedMigrationJob != null)
        {
            // Get IDs for comparison
            var existingIds = CurrentlyLoadedMigrationJob.MigrationUnitBasics.Select(mu => mu.Id).ToHashSet();
            var newIds = migrationUnits.Select(mu => mu.Id).ToHashSet();

            //get ids that are no llonger present in newUnits
            var delList = CurrentlyLoadedMigrationJob.MigrationUnitBasics.FindAll(mu => !newIds.Contains(mu.Id));

            foreach (var tobDel in delList)
            {
                tobDel.ParentJob = CurrentlyLoadedMigrationJob;
                tobDel.Remove();
                MigrationJobContext.MigrationUnitsCache.RemoveMigrationUnit(tobDel.Id);//remove from cache
            }

            foreach (var mu in migrationUnits)
            {
                mu.ParentJob = CurrentlyLoadedMigrationJob;                
            }

            // Add new units that don’t exist in existingUnits
            // foreach (var mu in migrationUnits)
            // {
            //     if (!CurrentlyLoadedMigrationJob.MigrationUnitBasics.Any(x => x.DatabaseName == mu.DatabaseName && x.CollectionName == mu.CollectionName))
            //     {
            //         MigrationJobContext.SaveMigrationUnit(mu,false);
            //         //CurrentlyLoadedMigrationJob.MigrationUnitBasics.Add(mu.GetBasic());
            //         Helper.AddMigrationUnit(mu, CurrentlyLoadedMigrationJob);
            //     }
            // }
            if (!Helper.AddMigrationUnits(migrationUnits, CurrentlyLoadedMigrationJob))
            {
                _errorMessage = "Target namespace clash detected. Multiple source collections cannot map to the same target collection.";
                return;
            }

            CurrentlyLoadedMigrationJob.NameSpaces = string.Join(",", migrationUnits.Select(mu => $"{mu.KeyspaceName}.{mu.TableName}"));

            MigrationJobContext.SaveMigrationJob(CurrentlyLoadedMigrationJob);

            Refresh(null);
        }
    }




    private void YesNoDialogSubmit(YesNoDialog.YesNoDialogResult result)
    {
        _yesNoDialogOpen = false;

        if (result.IsConfirmed)
        {     
            if (result.DiaLogType == YesNoDialog.Category.CutoverNot
                || result.DiaLogType == YesNoDialog.Category.CompleteNot)
            {
                MigrationJobContext.AddVerboseLog($"YesNoDialogSubmit Cutover {result.DiaLogType}");
                JobManager.StopMigration();                
                if (CurrentlyLoadedMigrationJob != null)
                {
                    CurrentlyLoadedMigrationJob.Status = JobStatus.Completed;
                }

                if (MigrationJobContext.SaveMigrationJob(CurrentlyLoadedMigrationJob))
                    return;

                _refreshTimer = null;
            }
            else if (result.DiaLogType == YesNoDialog.Category.CancelNot)
            {
                MigrationJobContext.AddVerboseLog($"YesNoDialogSubmit Cancel {result.DiaLogType}");
                JobManager.StopMigration();                
                if (CurrentlyLoadedMigrationJob != null)
                {
                    CurrentlyLoadedMigrationJob.Status = JobStatus.Cancelled;
                }

                if (MigrationJobContext.SaveMigrationJob(CurrentlyLoadedMigrationJob))
                    return;

                _refreshTimer = null;
            }
        }
    }

    private void PauseJobImmediate()
    {
        _errorMessage = string.Empty;
        JobManager.StopMigration();
        if (CurrentlyLoadedMigrationJob != null)
        {
            CurrentlyLoadedMigrationJob.Status = JobStatus.Paused;
        }
        MigrationJobContext.SaveMigrationJob(
            CurrentlyLoadedMigrationJob);
    }

    private void PauseJobControlled()
    {
        _errorMessage = string.Empty;
        MigrationJobContext.RequestControlledPause("UI Button Click");

        if (MigrationJobContext.SaveMigrationJob(CurrentlyLoadedMigrationJob))
            return;
    }

    private bool NoOtherActiveJobs()
    {        

        string activeJob = JobManager?.GetRunningJobId() ?? string.Empty;
        if (activeJob != string.Empty && activeJob != JobId)
        {
            var job = MigrationJobContext.GetMigrationJob(activeJob);
            if (job != null && !job.IsCancelled && !job.IsCompleted)
                return false;
            else
                return true;
        }
        else
            return true;
    }

    private  bool  IsPauseEnabled()
    {
        return CurrentlyLoadedMigrationJob != null && !CurrentlyLoadedMigrationJob.IsCancelled && !CurrentlyLoadedMigrationJob.IsCompleted && IsJobRunning() && NoOtherActiveJobs();
    }


    private bool IsResumeEnabled()
    {
        return CurrentlyLoadedMigrationJob != null && !CurrentlyLoadedMigrationJob.IsCompleted && !IsJobRunning();
    }

    private bool CanAutoStart()
    {
        if (CurrentlyLoadedMigrationJob == null)
            return false;

        // Only auto-start if this job was just created
        // from the Index page (in-memory flag, not persisted)
        if (!MigrationJobContext.PendingAutoStartJobIds
                .ContainsKey(CurrentlyLoadedMigrationJob.Id))
            return false;

        if (IsResumeEnabled() && NoOtherActiveJobs()
            && (!string.IsNullOrEmpty(GetSourceConnectionString(CurrentlyLoadedMigrationJob))
                || !string.IsNullOrEmpty(GetTargetConnectionString(CurrentlyLoadedMigrationJob))))
        {
            return true;
        }
        return false;
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    // Response model for log count API
    public class LogCountResponse
    {
        public int count { get; set; }
    }

    private string GetJobStatusLabel(MigrationJob job)
    {
        if (job.IsCompleted) return "Completed";
        if (job.IsCancelled) return "Cancelled";
        if (IsJobRunning())
        {
            if (MigrationJobContext.ControlledPauseRequested)
                return "Pausing...";
            return "Running";
        }
        if (job.IsFaulted) return "Faulted";
        if (job.IsPaused) return "Paused";
        if (job.IsStarted) return "Stopped";
        return "Not Started";
    }

    private string GetJobStatusBadge(MigrationJob job)
    {
        if (job.IsCompleted) return "bg-success";
        if (job.IsCancelled) return "bg-secondary";
        if (IsJobRunning())
        {
            if (MigrationJobContext.ControlledPauseRequested)
                return "bg-warning text-dark";
            return "bg-primary";
        }
        if (job.IsFaulted) return "bg-danger";
        if (job.IsPaused) return "bg-warning text-dark";
        if (job.IsStarted) return "bg-info";
        return "bg-secondary";
    }
