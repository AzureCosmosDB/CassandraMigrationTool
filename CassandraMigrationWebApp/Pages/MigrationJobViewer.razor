    private bool CheckCutoverReadiness()
    {
        if (CurrentlyLoadedMigrationJob?.MigrationUnitBasics == null)
            return false;
        return CurrentlyLoadedMigrationJob.MigrationUnitBasics.All(mu =>
            mu.SourceStatus == CollectionStatus.NotFound || mu.CopyComplete);
