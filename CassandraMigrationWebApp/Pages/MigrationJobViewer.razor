@page "/migrationjobviewer/{jobId}"
@using MigrationJobType = CassandraMigrationProcessor.MigrationJob
@using CassandraMigrationWebApp.Components
@using CassandraMigrationWebApp.Helpers
@using CassandraMigrationProcessor
@using CassandraMigrationProcessor.Context
@using CassandraMigrationProcessor.Helpers
@using CassandraMigrationProcessor.Models
@using System.Linq

@inject Service.JobManager JobManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Service.FileService FileService
@inject HttpClient HttpClient
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>
        <button class="btn btn-light" @onclick="GoBack" title="Back to Job List" style="border: none; background: transparent;">
            <i class="bi bi-arrow-left"></i>
        </button>
        @CurrentlyLoadedMigrationJob?.Name - Job Status
    </h3>
    <div class="d-flex align-items-center mb-3">

        @if (IsResumeEnabled() && !_isLoadingCollections)
        {
            <div class="btn-group mx-2">
                <button class="btn btn-primary dropdown-toggle" type="button" id="resumeJobDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    Resume Job
                </button>
                <ul class="dropdown-menu" aria-labelledby="resumeJobDropdown">
                    <li><a class="dropdown-item" @onclick="ResumeJobWithNewConnectionString">With Updated Connection Strings</a></li>
                    @if (CurrentlyLoadedMigrationJob != null && !string.IsNullOrEmpty(GetSourceConnectionString(CurrentlyLoadedMigrationJob)) && !string.IsNullOrEmpty(GetTargetConnectionString(CurrentlyLoadedMigrationJob)))
                    {
                        <li><a class="dropdown-item" @onclick="ResumeJobWithExistingConnectionString">With Existing Connection Strings</a></li>
                    }
                </ul>
            </div>
        }

        @if (IsPauseEnabled() && !_isLoadingCollections)
        {
            @* Pause Job - with dropdown for controlled pause if applicable *@
            @if (CurrentlyLoadedMigrationJob != null && JobManager.IsControlledPauseApplicable(CurrentlyLoadedMigrationJob.JobType, CurrentlyLoadedMigrationJob))
            {
                <div class="btn-group mx-2">
                    <button class="btn btn-primary dropdown-toggle" type="button" id="pauseJobDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Choose pause method">
                        Pause Job
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="pauseJobDropdown">
                        <li><a class="dropdown-item" @onclick="PauseJobControlled" title="Stops accepting new chunks but allows active chunks to complete"><i class="bi bi-pause-circle"></i> Controlled Pause (Graceful)</a></li>
                        <li><a class="dropdown-item" @onclick="PauseJobImmediate" title="Immediately cancels all operations"><i class="bi bi-stop-circle"></i> Immediate Stop</a></li>
                    </ul>
                </div>
            }
            else
            {
                <button class="btn btn-primary mx-2" title="Pause Job" @onclick="PauseJobImmediate">Pause Job</button>
            }
            
            @* Display controlled pause status *@
            @if (JobManager.IsControlledPauseRequested() && IsJobRunning())
            {
                <span class="badge bg-warning text-dark mx-2" title="Controlled pause in progress - waiting for active chunks to complete">
                    <i class="bi bi-hourglass-split"></i> Pausing...
                </span>
            }
            
            @if (CurrentlyLoadedMigrationJob != null && Helper.IsOnline(CurrentlyLoadedMigrationJob))
            {
                var lagInfo = GetChangeFeedLag();
                <span class="badge @(lagInfo.IsLow ? "bg-success" : "bg-warning text-dark") me-1"
                      title="Time since last change feed event across all tables">
                    <i class="bi bi-clock-history"></i> Lag: @lagInfo.Display
                </span>
                <button class="btn btn-warning" title="Perform Cut Over — stops change feed and completes migration" disabled="@(!CheckCutoverReadiness())" @onclick="CompleteJob">
                    <i class="bi bi-check2-circle"></i> Cut Over
                </button>
            }

            <button class="btn btn-danger mx-1" title="Cancel this migration permanently" @onclick="ConfirmCancelJob">
                <i class="bi bi-x-circle"></i> Cancel
            </button>

            <button class="btn btn-toolbar" title="Refresh" @onclick="Refresh">
                <i class="bi bi-arrow-repeat"></i>
            </button>

            <button class="btn btn-sm @((CurrentlyLoadedMigrationJob?.AutoRefreshEnabled ?? true) ? "btn-outline-success" : "btn-outline-secondary") ms-2" 
                    @onclick="ToggleAutoRefresh" 
                    title="@((CurrentlyLoadedMigrationJob?.AutoRefreshEnabled ?? true) ? "Auto-refresh is ON - Click to pause UI updates" : "Auto-refresh is OFF - Click to resume UI updates")"
                    style="border: 1px solid;">
                <i class="bi @((CurrentlyLoadedMigrationJob?.AutoRefreshEnabled ?? true) ? "bi-play-fill" : "bi-pause-fill")"></i>
            </button>
        }

    </div>
</div>


@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-2">
        @_errorMessage
        <button type="button" class="btn-close btn-close-sm" aria-label="Close" @onclick="() => _errorMessage = string.Empty"></button>
    </div>
}

@* ── Job Status Summary Card ── *@
@if (CurrentlyLoadedMigrationJob != null && !_isLoadingCollections)
{
    var sj = CurrentlyLoadedMigrationJob;
    var statusLabel = GetJobStatusLabel(sj);
    var statusBadge = GetJobStatusBadge(sj);
    var allUnits = sj.MigrationUnitBasics ?? new List<MigrationUnitBasic>();
    int totalTables = allUnits.Count;
    int copyDone = allUnits.Count(u => u.CopyComplete);
    int inProgress = allUnits.Count(u => !u.CopyComplete && u.CopyPercent > 0);
    int failedTables = allUnits.Count(u => u.SourceStatus == CollectionStatus.Failed);
    long totalRows = allUnits.Sum(u => (long)u.CopyRowsCopied);
    long totalDocs = allUnits.Sum(u => (long)u.TotalDocCount);
    double avgSpeed = allUnits.Where(u => u.CopyRowsPerSecond > 0).Select(u => u.CopyRowsPerSecond).DefaultIfEmpty(0).Sum();

    <div class="card mb-3 mt-2">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <span class="badge @statusBadge fs-6">@statusLabel</span>
                </div>
                <div class="col">
                    <small class="text-muted">
                        <strong>Type:</strong> @sj.JobType
                        @if (Helper.IsOnline(sj)) { <span> · <strong>Mode:</strong> Online (CDC)</span> }
                        else { <span> · <strong>Mode:</strong> Offline</span> }
                        @if (sj.StartedOn.HasValue) { <span> · <strong>Started:</strong> @sj.StartedOn.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }
                        @if (sj.IsSimulatedRun) { <span class="badge bg-info ms-1">Simulated</span> }
                    </small>
                </div>
            </div>
            <hr class="my-1" />
            <div class="row">
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-table"></i>
                        <strong>Tables:</strong> @copyDone/@totalTables done
                        @if (inProgress > 0) { <span>, @inProgress active</span> }
                        @if (failedTables > 0) { <span class="text-danger">, @failedTables failed</span> }
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-files"></i>
                        <strong>Rows copied:</strong> @totalRows.ToString("N0")@(totalDocs > 0 ? $" / {totalDocs:N0}" : "")
                    </small>
                </div>
                @if (totalDocs > 0)
                {
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-database"></i>
                        <strong>Total documents:</strong> @totalDocs.ToString("N0")
                    </small>
                </div>
                }
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-speedometer2"></i>
                        <strong>Speed:</strong>
                        @{ var sp = avgSpeed; }
                        @(sp >= 1000 ? $"{sp/1000:F1}k/s" : $"{sp:F0}/s")
                    </small>
                </div>
                @if (avgSpeed > 0 && totalDocs > totalRows)
                {
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i>
                        <strong>ETA:</strong>
                        @{
                            long remaining = totalDocs - totalRows;
                            double etaSec = remaining / avgSpeed;
                            string etaStr;
                            if (etaSec < 60) etaStr = $"{etaSec:F0}s";
                            else if (etaSec < 3600) etaStr = $"{etaSec/60:F0}m {etaSec%60:F0}s";
                            else etaStr = $"{etaSec/3600:F0}h {(etaSec%3600)/60:F0}m";
                        }
                        @etaStr
                    </small>
                </div>
                }
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-cpu"></i>
                        <strong>Workers:</strong> @sj.MaxFeedRangeParallelism
                        · <strong>Parallel tables:</strong> @sj.ParallelThreads
                        · <strong>Connections/host:</strong> @(sj.MaxConnectionsPerHost > 0 ? sj.MaxConnectionsPerHost.ToString() : "8")
                        · <strong>Page size:</strong> @(sj.PageSize > 0 ? sj.PageSize.ToString() : "500")
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="bi bi-hdd-network"></i>
                        <strong>Namespaces:</strong> @(sj.NameSpaces ?? "all")
                    </small>
                </div>
                @if (sj.DropTargetTableBeforeStart)
                {
                    <div class="col-auto">
                        <span class="badge bg-danger">Drop target tables</span>
                    </div>
                }
                @if (sj.AppendMode)
                {
                    <div class="col-auto">
                        <span class="badge bg-info">Append mode</span>
                    </div>
                }
            </div>
        </div>
    </div>
}


@if (_migrationDetailsPopUpOpen && CurrentlyLoadedMigrationJob != null)
{
    <CassandraMigrationWebApp.Components.MigrationDetails NewMode=false
                                                      Job="@CurrentlyLoadedMigrationJob"
                                                      OnSubmit="@OnMigrationDetailsPopUpSubmit"
                                                      CheckNameExists="CheckIfNameExistsAsync" />
}

@if (_yesNoDialogOpen)
{
   <YesNoDialog Type=_yesNoDiaLogType Caption="Confirmation Required" Message="@_message" OnClose="@YesNoDialogSubmit" />
}
@if (_manageCollectionDialogOpen && CurrentlyLoadedMigrationJob != null)
{
    <ManageCollections MigrationJob="@CurrentlyLoadedMigrationJob" MigrationUnits="@JobManager.GetMigrationUnits(CurrentlyLoadedMigrationJob)" SourceConnectionString="@GetSourceConnectionString(CurrentlyLoadedMigrationJob)" OnCollectionsUpdated="@OnCollectionsUpdated" />
}

@if (_resetChangeStreamDialogOpen && CurrentlyLoadedMigrationJob != null)
{
    <ResetChangeStream MigrationUnits="@((@JobManager.GetMigrationUnits(CurrentlyLoadedMigrationJob) ?? new List<MigrationUnit>()).Where(mu => Helper.IsMigrationUnitValid(mu)).ToList())" OnCollectionsUpdated="@OnCSReset" />
}
@if (_collectionDetailsDialogOpen && _selectedMigrationUnit != null)
{
    <CollectionDetails MigrationJob="@CurrentlyLoadedMigrationJob" MigrationUnit="@MigrationJobContext.GetMigrationUnit(_selectedMigrationUnit.Id, CurrentlyLoadedMigrationJob.Id)" OnClose="HandleCollectionDetailsClose" />
}

@* Collections Loading Spinner *@
@if (_isLoadingCollections)
{
    <div class="d-flex justify-content-center align-items-center my-4">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div>
                <h5>Loading Tables...</h5>
                <p class="text-muted">Please wait while we discover and load the tables from your keyspace.</p>
            </div>
        </div>
    </div>
}

@* Collections Filter and Pagination Controls *@
@if (CurrentlyLoadedMigrationJob != null && CurrentlyLoadedMigrationJob.MigrationUnitBasics != null && CurrentlyLoadedMigrationJob.MigrationUnitBasics.Count > 0 && !_isLoadingCollections)
{
    <div class="collections-filter-section">
        <div class="row">
            <div class="col-md-8">
                <div class="input-group filter-input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Filter tables by any column (keyspace, table, status, etc.)" 
                           @bind="_filterText" @bind:event="oninput" @onkeyup="OnFilterChanged" />
                    @if (!string.IsNullOrWhiteSpace(_filterText))
                    {
                        <button class="btn btn-outline-secondary filter-clear-btn" type="button" @onclick="ClearFilter" title="Clear filter">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex justify-content-end">
                    <div class="page-size-selector-top">
                        <select id="pageSizeSelect" class="form-select form-select-sm page-size-dropdown" @bind="_pageSize" @bind:after="OnPageSizeChanged" style="width: auto;" title="Items per page">
                            <option value="10">10 per page</option>
                            <option value="25">25 per page</option>
                            <option value="50">50 per page</option>
                            <option value="100">100 per page</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="collections-table-wrapper">
    <table class="table collections-table">
        <thead>
            <tr>
                <th class="sortable-header @GetSortClass("KeyspaceName")" @onclick='() => SortBy("KeyspaceName")' style="cursor: pointer;">
                    Keyspace Name
                    <i class="bi @GetSortIcon("KeyspaceName") ms-1"></i>
                </th>
                <th class="sortable-header @GetSortClass("TableName")" @onclick='() => SortBy("TableName")' style="cursor: pointer;">
                    Table Name
                    <i class="bi @GetSortIcon("TableName") ms-1"></i>
                </th>
                <th class="sortable-header @GetSortClass("CopyStatus")" @onclick='() => SortBy("CopyStatus")' style="cursor: pointer; min-width: 180px;">
                    Progress
                    <i class="bi @GetSortIcon("CopyStatus") ms-1"></i>
                </th>
                <th class="sortable-header @GetSortClass("RowsCopied")" @onclick='() => SortBy("RowsCopied")' style="cursor: pointer;">
                    Rows Copied
                    <i class="bi @GetSortIcon("RowsCopied") ms-1"></i>
                </th>
                @if (CurrentlyLoadedMigrationJob != null && Helper.IsOnline(CurrentlyLoadedMigrationJob))
                {
                    <th class="sortable-header @GetSortClass("TimeSinceLastChange")" @onclick='() => SortBy("TimeSinceLastChange")' style="cursor: pointer;">
                        Time Since Last Change
                        <i class="bi @GetSortIcon("TimeSinceLastChange") ms-1"></i>
                    </th>
                    <th class="sortable-header @GetSortClass("TimeSinceLastBatch")" @onclick='() => SortBy("TimeSinceLastBatch")' style="cursor: pointer;">
                        CS Last Checked
                        <i class="bi @GetSortIcon("TimeSinceLastBatch") ms-1"></i>
                    </th>
                    <th class="sortable-header @GetSortClass("LastBatchChanges")" @onclick='() => SortBy("LastBatchChanges")' style="cursor: pointer;">
                        Last Batch – Total Changes
                        <i class="bi @GetSortIcon("LastBatchChanges") ms-1"></i>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (!_isLoadingCollections && CurrentlyLoadedMigrationJob != null && CurrentlyLoadedMigrationJob.MigrationUnitBasics != null && GetFilteredAndPagedUnits().Any())
            {
                @foreach (var mu in GetFilteredAndPagedUnits())
                {
                    <tr>
                        <td>
                            <i class="bi bi-info-circle-fill me-2 collection-info-icon" title="More info" style="cursor: pointer;"
                               @onclick="() => ShowCollectionDetails(mu)"></i>
                            <i class="bi bi-download me-2 collection-info-icon" title="Download JSON" style="cursor: pointer;"
                               @onclick="() => DownloadMigrationUnit(mu)"></i>
                                     @GetDatabaseDisplayName(mu)
                        </td>
                                <td>@GetCollectionDisplayName(mu)</td>
                        <td style="min-width: 180px;">
                            @{
                                string copyStatus;
                                string barColor = "bg-primary";
                                double pct = 0;

                                if (mu.SourceStatus == CollectionStatus.NotFound)
                                { copyStatus = "Skipped (404)"; barColor = "bg-secondary"; pct = 100; }
                                else if (mu.SourceStatus == CollectionStatus.Failed)
                                { copyStatus = "Failed"; barColor = "bg-danger"; pct = 100; }
                                else if (mu.SkippedDueToMaxRetries)
                                { copyStatus = "Skipped (Max Retries)"; barColor = "bg-warning"; pct = 100; }
                                else if (mu.CopyComplete)
                                { copyStatus = "Complete"; barColor = "bg-success"; pct = 100; }
                                else if (mu.CopyPercent > 0)
                                {
                                    pct = Math.Min(mu.CopyPercent, 99.9);
                                    string speedStr = mu.CopyRowsPerSecond >= 1000
                                        ? $"{mu.CopyRowsPerSecond/1000:F1}k/s"
                                        : mu.CopyRowsPerSecond > 0
                                            ? $"{mu.CopyRowsPerSecond:F0}/s" : "";
                                    copyStatus = speedStr != "" ? $"{pct:F1}% ({speedStr})" : $"{pct:F1}%";
                                }
                                else if (mu.CopyRowsCopied > 0)
                                {
                                    pct = 5; // indeterminate — show small bar
                                    string speedStr = mu.CopyRowsPerSecond >= 1000
                                        ? $"{mu.CopyRowsPerSecond/1000:F1}k/s"
                                        : mu.CopyRowsPerSecond > 0
                                            ? $"{mu.CopyRowsPerSecond:F0}/s" : "";
                                    copyStatus = speedStr != "" ? $"Copying ({speedStr})" : "Copying...";
                                }
                                else
                                { copyStatus = "Pending"; pct = 0; }
                            }
                            <div class="progress" style="height: 20px; position: relative;">
                                <div class="progress-bar @barColor" role="progressbar"
                                     style="width: @($"{pct:F0}")%"
                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                </div>
                                <span style="position: absolute; width: 100%; text-align: center; font-size: 0.75rem; line-height: 20px; color: @(pct > 50 ? "white" : "black");">
                                    @copyStatus
                                </span>
                            </div>
                        </td>
                        <td>
                            @(mu.CopyRowsCopied > 0 ? mu.CopyRowsCopied.ToString("N0") : "-")
                        </td>

                        @if (CurrentlyLoadedMigrationJob != null && Helper.IsOnline(CurrentlyLoadedMigrationJob))
                        {
                            <td title="Avg Read Latency: @mu.ChangeFeedAvgReadLatencyInMS.ToString("F2") ms | Avg Write Latency: @mu.ChangeFeedAvgWriteLatencyInMS.ToString("F2") ms">                           
                                @(mu.ChangeFeedLastChecked.HasValue ? Helper.GetTimestampDiff(mu.ChangeFeedLastChecked.Value) : "NA")
                            </td>
                            <td>
                                @GetTimeSinceLastBatch(CurrentlyLoadedMigrationJob, mu)
                            </td>
                            <td>
                                @mu.ChangeFeedUpdatesInLastBatch
                            </td>
                        }
                    </tr>
                }
            }
            else if (!_isLoadingCollections && CurrentlyLoadedMigrationJob != null && CurrentlyLoadedMigrationJob.MigrationUnitBasics!= null && !string.IsNullOrWhiteSpace(_filterText))
            {
                <tr>
                    <td colspan="10" class="empty-collections-state">
                        <i class="bi bi-search"></i>
                        <h5>No tables match your filter</h5>
                        <p>Try adjusting your search terms or <button class="btn btn-link p-0" @onclick="ClearFilter">clear the filter</button></p>
                    </td>
                </tr>
            }
            else if (!_isLoadingCollections && (CurrentlyLoadedMigrationJob == null || CurrentlyLoadedMigrationJob.MigrationUnitBasics == null || !CurrentlyLoadedMigrationJob.MigrationUnitBasics.Any()))
            {
                <tr>
                    <td colspan="10" class="empty-collections-state">
                        <i class="bi bi-collection"></i>
                        <h5>No tables configured</h5>
                        <p>Use the "Update Tables" button below to add tables to this migration job.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Pagination Controls *@
@if (!_isLoadingCollections && GetTotalPages() > 1)
{
    <nav aria-label="Collections pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(IsFirstPage() ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(1)" disabled="@IsFirstPage()" title="First page">
                    <i class="bi bi-chevron-double-left"></i>
                </button>
            </li>
            <li class="page-item @(IsFirstPage() ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_currentPage - 1)" disabled="@IsFirstPage()" title="Previous page">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </li>

            @for (int page = GetStartPage(); page <= GetEndPage(); page++)
            {
                var pageNumber = page;
                <li class="page-item @(_currentPage == pageNumber ? "active" : "")">
                    <button class="page-link" @onclick="() => GoToPage(pageNumber)" title="Go to page @pageNumber">
                        @pageNumber
                    </button>
                </li>
            }

            <li class="page-item @(IsLastPage() ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_currentPage + 1)" disabled="@IsLastPage()" title="Next page">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </li>
            <li class="page-item @(IsLastPage() ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(GetTotalPages())" disabled="@IsLastPage()" title="Last page">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
            </li>
        </ul>
        
        <div class="text-center mt-2">
            <small class="text-muted">
                Page @_currentPage of @GetTotalPages() 
                (@GetFilteredItemsCount() @(GetFilteredItemsCount() == 1 ? "table" : "tables"))
            </small>
        </div>
    </nav>
}

@if(!_isLoadingCollections && (IsPauseEnabled() || IsResumeEnabled()))
{
    <div class="d-flex align-items-center mb-3 mt-4">
        <button class="btn btn-primary mx-2" title="You can add or remove collections from this job. Be sure to pause the job before doing so." @onclick="ManageCollections" disabled="@_isLoadingCollections">Update Tables</button>
        @if (CurrentlyLoadedMigrationJob != null && Helper.IsOnline(CurrentlyLoadedMigrationJob))
        {
            <button class="btn btn-warning mx-2" title="Reset the change feed checkpoint." @onclick="ResetChangeStream">
                Reset Change Feed
            </button>
        }
    
    </div>
}

@if ((CurrentlyLoadedMigrationJob?.AutoRefreshEnabled ?? true) && LogBucket != null && VerboseMessages != null && VerboseMessages.Count > 0 && !_showLogBackupFile)
{
    <h5 class="pt-4">
        Monitor
    </h5>
    <div>
        <table class="table message-output">
            <tbody>
                @foreach (var logObject in VerboseMessages)
                {
                    <tr>
                        <td>
                            @if(string.IsNullOrEmpty(logObject.Message))
                            {
                                <span>&nbsp;</span>
                            }
                            else
                            {
                                <span>@logObject.Datetime - @logObject.Message</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (LogBucket != null && LogBucket.Logs != null && !_showLogBackupFile)
{
    <div class="d-flex justify-content-between align-items-center pt-4">
        <h5 class="mb-0">
            <button class="btn btn-light" @onclick="DownloadFile" title="Download Log File" style="border: none; background: transparent;">
                <i class="bi bi-download"></i>
            </button> Logs
        </h5>
        <div class="d-flex align-items-center">
            <input type="text" class="form-control form-control-sm me-2" style="width: 200px;"
                   placeholder="Filter logs (e.g. table name)"
                   @bind="_logFilter" @bind:event="oninput" />
            <label class="me-2 mb-0" style="font-weight: normal;">Level:</label>
            <select class="form-select form-select-sm" style="width: auto;" value="@(CurrentlyLoadedMigrationJob?.LogLevel ?? LogType.Info)" @onchange="OnLogLevelChanged">
                <option value="@LogType.Error">Error Only</option>
                <option value="@LogType.Warning">Warning + Error</option>
                <option value="@LogType.Info">Info + Warning + Error</option>
                <option value="@LogType.Debug">Debug + Info + Warning + Error</option>
                <option value="@LogType.Verbose">All (Verbose)</option>
            </select>
        </div>
    </div>


    <table class="table console-output mt-2">
        <thead>
            <tr>
                <th class="log-icon-header"></th>
                <th style="width: 150px;">Date Time (UTC)</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>

            @{ var displayLogLevel = CurrentlyLoadedMigrationJob?.LogLevel ?? LogType.Info; }
            @{ var logFilterText = _logFilter?.Trim() ?? string.Empty; }
            @foreach (var logObject in LogBucket.Logs.TakeLast(200).Reverse()
                .Where(l => (int)l.Type <= (int)displayLogLevel)
                .Where(l => string.IsNullOrEmpty(logFilterText)
                    || (l.Message != null && l.Message.Contains(logFilterText, StringComparison.OrdinalIgnoreCase))))
            {
                <tr class="@GetRowClass(logObject.Type.ToString(),logObject.Message)">
                    <td class="log-icon-cell">@GetLogIcon(logObject.Type)</td>
