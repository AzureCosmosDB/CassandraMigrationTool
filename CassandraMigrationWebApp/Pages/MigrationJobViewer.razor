    private List<MigrationUnitBasic> ApplySorting(List<MigrationUnitBasic> units)
    {
        if (units == null || !units.Any())
            return units ?? new List<MigrationUnitBasic>();

        return _sortColumn switch
        {
            "KeyspaceName" => _sortAscending 
                ? units.OrderBy(u => u.KeyspaceName).ToList()
                : units.OrderByDescending(u => u.KeyspaceName).ToList(),

            "TableName" => _sortAscending
                ? units.OrderBy(u => u.TableName).ToList()
                : units.OrderByDescending(u => u.TableName).ToList(),

            "CopyStatus" => _sortAscending
                ? units.OrderBy(u => GetSortValueForStatus(u)).ToList()
                : units.OrderByDescending(u => GetSortValueForStatus(u)).ToList(),

            "RowsCopied" => _sortAscending
                ? units.OrderBy(u => u.CopyRowsCopied).ToList()
                : units.OrderByDescending(u => u.CopyRowsCopied).ToList(),

            "TimeSinceLastChange" => _sortAscending
                ? units.OrderBy(u => GetSortValueForTimestamp(u)).ToList()
                : units.OrderByDescending(u => GetSortValueForTimestamp(u)).ToList(),

            "TimeSinceLastBatch" => _sortAscending
                ? units.OrderBy(u => GetSortValueForLastBatch(u)).ToList()
                : units.OrderByDescending(u => GetSortValueForLastBatch(u)).ToList(),

            "LastBatchChanges" => _sortAscending
